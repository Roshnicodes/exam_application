<% content_for :title, @invitation.candidate_name %>
<%= turbo_stream_from @invitation, :events %>
<% link = exam_url(@invitation.token) %>
<% share_text = candidate_share_text(@invitation) %>

<% chips = []
   chips << [ "calendar", @invitation.interview_date.strftime("%d %b %Y, %-I:%M %p") ] if @invitation.interview_date
   chips += [ [ "clock", "#{@invitation.quiz.duration_minutes} min" ], [ "list", "#{@invitation.quiz.questions.size} questions" ] ]
   chips << [ "lock", "Link valid till #{@invitation.link_expires_at.strftime('%d %b, %-I:%M %p')}" ] if @invitation.link_expires_at %>
<% share = capture do %>
  <div data-controller="clipboard">
    <div class="share-box">
      <%= icon("link") %>
      <input type="text" value="<%= link %>" readonly data-clipboard-target="source" aria-label="Exam link">
      <button type="button" class="btn btn-primary btn-sm" data-action="clipboard#copy"><%= icon("copy") %> <span data-clipboard-target="label">Copy link</span></button>
    </div>
    <div class="share-actions">
      <%= whatsapp_button(@invitation.candidate_phone.presence || @invitation.entered_phone, share_text) %>
      <a class="btn btn-light btn-sm" href="mailto:<%= @invitation.candidate_email %>?subject=<%= ERB::Util.url_encode("Online assessment - #{@invitation.vacancy}") %>&body=<%= ERB::Util.url_encode(share_text) %>"><%= icon("mail") %> Email</a>
      <a class="btn btn-light btn-sm" href="<%= link %>" target="_blank" rel="noopener"><%= icon("eye") %> Preview</a>
    </div>
  </div>
<% end %>
<%= render layout: "shared/page_header", locals: {
      title: @invitation.candidate_name, avatar: initials_for(@invitation.candidate_name),
      subtitle: [ @invitation.vacancy, @invitation.department.presence, @invitation.quiz.title ].compact.join(" · "),
      crumbs: [ [ "Candidates", invitations_path ] ], chips: chips, extra: share } do %>
  <%= link_to export_invitation_path(@invitation), class: "btn btn-light btn-sm", data: { turbo: false } do %><%= icon("download") %> Download Excel<% end %>
  <%= link_to edit_invitation_path(@invitation), class: "btn btn-light btn-sm" do %><%= icon("edit") %> Edit<% end %>
  <%= button_to invitation_path(@invitation), method: :delete, class: "btn btn-light btn-sm", form: { data: { turbo_confirm: "Delete this invitation and all its recordings?" } } do %><%= icon("trash") %> Delete<% end %>
<% end %>

<div class="split">
  <div class="stack">
    <% unless @invitation.finished? %>
      <div class="card">
        <div class="card-head"><h2><%= icon("video") %> Live camera</h2></div>
        <div class="card-body"><%= render "shared/live_video", invitation: @invitation %></div>
      </div>
      <div class="card" id="test-call">
        <div class="card-head"><h2><%= icon("users") %> Video call during the test</h2></div>
        <div class="card-body"><%= render "shared/interview_room", invitation: @invitation, test_call: true, name: Current.user.name, auto_join: @invitation.in_progress?, talk: params[:talk].present? %></div>
      </div>
    <% end %>
    <%= render "interview_rounds/list", invitation: @invitation %>
    <% if @invitation.finished? %><%= render "invitations/answer_sheet", invitation: @invitation, collapsible: true %><% end %>
    <%= render "invitations/rough_work", invitation: @invitation %>
    <%= render "interview_feedbacks/summary", invitation: @invitation %>
    <%= render "invitations/call_chat", invitation: @invitation %>
    <%= render "invitations/code_pads", invitation: @invitation %>

    <div class="card">
      <div class="card-head"><h2><%= icon("bell") %> Proctoring timeline</h2><span class="pill"><span class="live-dot"></span> Live</span></div>
      <ul class="timeline scroll-y" id="events_invitation_<%= @invitation.id %>">
        <%= render partial: "proctor_events/proctor_event", collection: @events %>
      </ul>
      <% if @events.empty? %><div class="card-body muted small" style="padding-top:0">No activity yet. Events appear here instantly.</div><% end %>
    </div>

    <div class="card">
      <div class="card-head"><h2><%= icon("camera") %> Camera snapshots</h2><span class="tiny muted"><%= @snapshots.size %> captured</span></div>
      <div class="card-body">
        <% if @snapshots.any? %>
          <div class="snap-grid">
            <% @snapshots.each do |ev| %>
              <figure>
                <%= link_to rails_blob_path(ev.snapshot, disposition: "inline"), target: "_blank", rel: "noopener" do %>
                  <%= image_tag rails_blob_path(ev.snapshot, disposition: "inline"), alt: ev.label, loading: "lazy" %>
                <% end %>
                <figcaption><%= ev.kind == "snapshot" ? "Routine" : ev.label %> · <%= ev.created_at.strftime("%-I:%M:%S") %></figcaption>
              </figure>
            <% end %>
          </div>
        <% else %>
          <p class="muted small">Snapshots are captured every 30 seconds and on every violation.</p>
        <% end %>
      </div>
    </div>

    <div class="card">
      <div class="card-head"><h2><%= icon("video") %> Camera recordings</h2><span class="tiny muted"><%= @invitation.recordings.size %> segments</span></div>
      <div class="card-body">
        <% if @invitation.recordings.attached? %>
          <div class="video-grid">
            <% @invitation.recordings.order(:created_at).each_with_index do |rec, i| %>
              <div>
                <video src="<%= rails_blob_path(rec, disposition: "inline") %>" controls preload="metadata" playsinline></video>
                <div class="tiny muted" style="margin-top:.3rem"><b><%= rec.filename.to_s.include?("screen-") ? "🖥️ Screen" : "📷 Camera" %></b><%= " · #{rec.filename.to_s.split('-segment').first.split('screen').first.tr('-', ' ').strip.titleize}" if rec.filename.to_s.match?(/interview|round/) %> · <%= rec.created_at.strftime("%-I:%M:%S %p") %> · <%= number_to_human_size(rec.byte_size) %></div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="muted small">Camera (with audio) and the shared screen are recorded in 1-minute segments during the test and interviews.</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="stack">
    <% unless @invitation.finished? %>
      <div class="card card-pad lang-card">
        <div class="row between"><b><%= icon("file") %> Test language</b>
          <span class="tiny muted">Hindi ready: <%= @invitation.quiz.hindi_count %>/<%= @invitation.quiz.questions.size %></span></div>
        <div class="lang-switch">
          <% Invitation::LANGUAGES.each do |key, label| %>
            <%= button_to language_invitation_path(@invitation, language: key), method: :patch, class: ("active" if @invitation.language == key),
                  disabled: @invitation.language == key do %><%= key == "hi" ? "हिंदी" : "English" %><% end %>
          <% end %>
        </div>
        <p class="tiny muted"><%= @invitation.in_progress? ? "Switching changes the candidate's screen right away." : "The candidate sees the test in this language." %></p>
      </div>
    <% end %>
    <%= render "invitations/live_state", invitation: @invitation %>
    <%= render "invitations/selection_card", invitation: @invitation %>
    <%= render "invitations/decision_card", invitation: @invitation %>
    <% if @invitation.resume.attached? %>
      <div class="card card-pad row between">
        <span class="row"><span class="avatar soft"><%= icon("file") %></span><span><b class="small">Resume</b><br><span class="tiny muted"><%= @invitation.resume.filename %></span></span></span>
        <%= link_to rails_blob_path(@invitation.resume, disposition: "inline"), class: "btn btn-light btn-sm", target: "_blank" do %><%= icon("eye") %> Open<% end %>
      </div>
    <% end %>

    <%= render "shared/panel_card", panelists: @invitation.panelists, invitation: @invitation,
          watch_link: watch_url(@invitation.watch_token), edit_path: edit_invitation_path(@invitation) %>

    <div class="card">
      <div class="card-head"><h2><%= icon("user") %> Candidate details</h2></div>
      <div class="card-body kv">
        <div><span>Email</span><b><%= @invitation.candidate_email.presence || "—" %></b></div>
        <div><span>Mobile (HR)</span><b><%= @invitation.candidate_phone.present? ? "+91 #{@invitation.candidate_phone}" : "—" %></b></div>
        <div><span>Mobile (entered)</span><b><%= @invitation.entered_phone.present? ? "+91 #{@invitation.entered_phone}" : "—" %></b></div>
        <div><span>Experience</span><b><%= @invitation.experience.presence || "—" %></b></div>
        <div><span>Mode</span><b><%= @invitation.interview_mode.presence || "—" %></b></div>
        <div><span>Risk level</span><b style="text-transform:capitalize"><%= @invitation.risk_level %></b></div>
        <div style="grid-column:1/-1"><span>Location / link</span><b><%= @invitation.location.presence || "—" %></b></div>
        <% if @invitation.notes.present? %><div style="grid-column:1/-1"><span>Notes</span><b style="font-weight:500"><%= @invitation.notes %></b></div><% end %>
      </div>
    </div>
  </div>
</div>
