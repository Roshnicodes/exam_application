<% content_for :title, "Interview · #{@invitation.candidate_name}" %>
<%= turbo_stream_from @invitation, :events %>
<%= render layout: "shared/page_header", locals: {
      title: "Interview — #{@invitation.candidate_name}", icon: "video",
      subtitle: @invitation.interview_open? ? "Room is open. The candidate joins from their exam link; panelists from their watch link." : "Room is closed — open it to let the candidate join.",
      crumbs: [ [ "Candidates", invitations_path ], [ @invitation.candidate_name, invitation_path(@invitation) ] ] } do %>
  <% if @invitation.interview_open? %>
    <%= button_to close_interview_invitation_path(@invitation), class: "btn btn-light", form: { data: { turbo_confirm: "End the interview for everyone?" } } do %><%= icon("x") %> End interview<% end %>
  <% else %>
    <%= button_to open_interview_invitation_path(@invitation), class: "btn btn-primary" do %><%= icon("play") %> Open room<% end %>
  <% end %>
<% end %>

<% side = capture do %>
  <%= render "interview_feedbacks/candidate_brief", invitation: @invitation, hr: true %>
  <div class="card" data-controller="clipboard">
    <div class="card-head"><h2><%= icon("link") %> Invite to the room</h2></div>
    <div class="card-body stack small">
      <div>
        <b>Candidate</b> — same exam link (OTP again on a new device)
        <div class="row" style="margin-top:.4rem">
          <input type="hidden" value="<%= exam_url(@invitation.token) %>" data-clipboard-target="source">
          <button type="button" class="btn btn-light btn-sm" data-action="clipboard#copy"><%= icon("copy") %> <span data-clipboard-target="label">Copy link</span></button>
          <%= whatsapp_button(@invitation.candidate_phone.presence || @invitation.entered_phone, "Hi #{@invitation.candidate_name}, your interview has started. Join here: #{exam_url(@invitation.token)}") %>
        </div>
      </div>
      <div><b>Panelists</b> — their watch link has a "Join interview" button. Share it from the <%= link_to "candidate page", invitation_path(@invitation) %>.</div>
      <% if @invitation.meeting_link.present? %><div><b>External meeting:</b> <%= link_to @invitation.meeting_link, @invitation.meeting_link, target: "_blank", rel: "noopener" %></div><% end %>
    </div>
  </div>
  <%= render "interview_feedbacks/form", invitation: @invitation, feedback: @feedback, url: feedback_invitation_path(@invitation) %>
  <%= render "interview_feedbacks/summary", invitation: @invitation %>
<% end %>

<%= render "shared/interview_room", invitation: @invitation, name: Current.user.name, leave_url: invitation_path(@invitation), side: side %>
