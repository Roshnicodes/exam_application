<%# Question paper with the candidate's answers. locals: invitation:, collapsible: false %>
<% questions = invitation.quiz.questions.to_a %>
<% picked = questions.map { |q| invitation.answers[q.id.to_s] } %>
<% correct = questions.each_with_index.count { |q, i| !picked[i].nil? && q.correct?(picked[i]) } %>
<% skipped = picked.count(&:nil?) %>
<% wrong = questions.size - correct - skipped %>
<% body = capture do %>
  <% questions.each_with_index do |q, i| %>
    <% given = picked[i] %>
    <div class="review-q">
      <div class="row between" style="align-items:flex-start">
        <div class="q-review-text"><b>Q<%= i + 1 %>.</b> <%= question_text(q.body) %></div>
        <% if given.nil? %>
          <span class="badge">Skipped</span>
        <% elsif q.correct?(given) %>
          <span class="badge sev-success">+<%= q.marks %> Correct</span>
        <% else %>
          <span class="badge sev-high">Wrong</span>
        <% end %>
      </div>
      <% q.options.each_with_index do |opt, idx| %>
        <div class="review-opt <%= 'correct' if idx == q.correct_index %> <%= 'wrong' if idx == given && idx != q.correct_index %>">
          <b><%= Question::LETTERS[idx] %>.</b> <%= opt %>
          <% if idx == given %><span class="tiny" style="margin-left:auto">Candidate's answer</span><% elsif idx == q.correct_index %><span class="tiny" style="margin-left:auto">Correct answer</span><% end %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
<div class="card answer-sheet" id="answer-sheet">
  <% head = capture do %>
    <h2><%= icon("file") %> Question paper &amp; answers</h2>
    <span class="row" style="gap:.35rem;flex-wrap:wrap">
      <span class="state-pill green"><%= correct %> correct</span>
      <span class="state-pill" style="background:#fee2e2;color:#b91c1c"><%= wrong %> wrong</span>
      <span class="state-pill"><%= skipped %> skipped</span>
      <span class="state-pill blue"><%= invitation.score.to_i %>/<%= invitation.total_marks.to_i %> marks</span>
    </span>
  <% end %>
  <% if local_assigns[:collapsible] %>
    <details>
      <summary class="card-head"><%= head %></summary>
      <%= body %>
    </details>
  <% else %>
    <div class="card-head"><%= head %></div>
    <%= body %>
  <% end %>
</div>
