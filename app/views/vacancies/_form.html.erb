<%= form_with model: vacancy, class: "card" do |f| %>
  <div class="form-section">
    <%= render "shared/errors", record: vacancy %>
    <div class="form-section-head">
      <span class="ico"><%= icon("briefcase") %></span>
      <div><h3>Post details</h3><p>Which department, what post and how many openings.</p></div>
    </div>
    <div class="fields">
      <div class="field" data-controller="combobox" data-combobox-placeholder-value="Search department…">
        <%= f.label :department_id do %>Department <span class="req">*</span><% end %>
        <%= f.select :department_id, @departments.map { |d| [ d.name, d.id, { "data-sub" => d.head_name.presence && "Head: #{d.head_name}" } ] }, { prompt: "Select department" }, required: true, class: "input", data: { combobox_target: "select" } %>
      </div>
      <div class="field">
        <%= f.label :title do %>Vacancy / post name <span class="req">*</span><% end %>
        <div class="input-wrap"><%= icon("briefcase") %><%= f.text_field :title, required: true, placeholder: "e.g. Senior Software Engineer", class: "input" %></div>
      </div>
      <div class="field">
        <%= f.label :code, "Vacancy code / ref no." %>
        <%= f.text_field :code, placeholder: "e.g. ENG/2026/014", class: "input" %>
      </div>
      <div class="field">
        <%= f.label :positions, "No. of posts" %>
        <div class="input-wrap"><%= icon("users") %><%= f.number_field :positions, min: 1, class: "input" %></div>
      </div>
      <div class="field">
        <%= f.label :issue_date, "Issue date" %>
        <div class="input-wrap"><%= icon("calendar") %><%= f.date_field :issue_date, class: "input" %></div>
      </div>
      <div class="field">
        <%= f.label :end_date, "End date" %>
        <div class="input-wrap"><%= icon("calendar") %><%= f.date_field :end_date, class: "input" %></div>
      </div>
    </div>
  </div>

  <div class="form-section">
    <div class="form-section-head">
      <span class="ico"><%= icon("graduation") %></span>
      <div><h3>Eligibility</h3><p>Qualification and experience required for this post.</p></div>
    </div>
    <div class="fields">
      <div class="field full">
        <%= f.label :qualification %>
        <%= f.text_area :qualification, rows: 2, placeholder: "e.g. B.Tech / MCA in Computer Science, minimum 60% marks", class: "input" %>
      </div>
      <div class="field">
        <%= f.label :experience_required, "Experience required" %>
        <%= f.select :experience_required, [ "Fresher", "0-1 years", "1-3 years", "3-5 years", "5-8 years", "8+ years" ], { include_blank: "Any" }, class: "input" %>
      </div>
      <div class="field">
        <%= f.label :description, "Job description" %>
        <%= f.text_field :description, placeholder: "Short summary of the role", class: "input" %>
      </div>
    </div>
  </div>

  <div class="form-section" data-controller="repeater">
    <div class="form-section-head">
      <span class="ico"><%= icon("target") %></span>
      <div class="grow"><h3>Selection parameters</h3><p>How candidates are evaluated, with weightage (total 100%). A stage named with <b>"test"</b> (e.g. Online test) takes the exam score automatically; every other stage (Technical interview, HR interview…) is scored 1-10 by the panel in the interview scorecard.</p></div>
      <span class="small">Total <span class="weight-total" data-repeater-target="total">0%</span></span>
    </div>
    <div data-repeater-target="list">
      <% Array(vacancy.selection_parameters).each do |param| %>
        <%= render "vacancies/param_row", param: param %>
      <% end %>
    </div>
    <template data-repeater-target="template"><%= render "vacancies/param_row", param: {} %></template>
    <button type="button" class="btn btn-light btn-sm" style="border-style:dashed" data-action="repeater#add"><%= icon("plus") %> Add parameter</button>
    <input type="hidden" name="vacancy[selection_parameters][][name]" value="">
  </div>

  <div class="form-section">
    <div class="form-section-head">
      <span class="ico"><%= icon("users") %></span>
      <div class="grow"><h3>Interview panelists</h3><p>Search and pick employees from your employee list.</p></div>
      <%= link_to employees_path, class: "btn btn-light btn-sm", target: "_blank" do %><%= icon("upload") %> Upload employees<% end %>
    </div>
    <% if @employees.any? %>
      <div class="field" data-controller="combobox" data-combobox-placeholder-value="Type a name, code, department…">
        <%= f.select :panelist_ids, @employees.map { |e| [ e.name, e.id, { "data-sub" => e.subtitle } ] }, {}, multiple: true, class: "input", data: { combobox_target: "select" } %>
        <span class="hint"><%= @employees.size %> employees available · use ↑ ↓ and Enter to pick quickly</span>
      </div>
    <% else %>
      <div class="waiting" style="margin:0"><%= icon("alert") %><span>No employees yet. <%= link_to "Upload your employee list", employees_path %> (Excel/CSV) to pick panelists.</span></div>
    <% end %>
  </div>

  <div class="form-actions">
    <%= link_to "Cancel", vacancy.persisted? ? vacancy_path(vacancy) : vacancies_path, class: "btn btn-light" %>
    <%= f.button class: "btn btn-primary" do %><%= icon("check") %> Save vacancy<% end %>
  </div>
<% end %>
