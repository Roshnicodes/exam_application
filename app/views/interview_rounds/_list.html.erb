<%# HR view of a candidate's rounds — interviews and practical assessments (replaced live via broadcasts). locals: invitation: %>
<% rounds = invitation.interview_rounds.to_a %>
<% employees = invitation.user.employees.ordered.to_a %>
<% assessments = invitation.user.assessments.active.ordered.to_a %>
<div id="rounds_invitation_<%= invitation.id %>" class="card rounds-card">
  <div class="card-head" id="rounds">
    <h2><%= icon("list") %> Selection rounds</h2>
    <span class="tiny muted"><%= Invitation::INTERVIEW_PLANS.dig(invitation.interview_plan, 0) %></span>
  </div>

  <ol class="round-steps">
    <% if invitation.test_required? %>
      <li class="round-step done-<%= invitation.finished? %>">
        <span class="rs-dot"><%= icon(invitation.finished? ? "check" : "file") %></span>
        <div class="rs-body">
          <div class="row between"><b>Online test</b><span class="badge <%= invitation.finished? ? 'sev-success' : '' %>"><%= invitation.finished? ? "#{invitation.percentage}%" : invitation.status_label %></span></div>
          <p class="tiny muted"><%= invitation.quiz.title %></p>
        </div>
      </li>
    <% end %>

    <% rounds.each do |round| %>
      <li class="round-step rs-<%= round.status %> <%= 'rs-task' if round.assessment? %>">
        <span class="rs-dot"><%= icon(round.assessment? ? round.task_icon : (round.completed? ? "check" : (round.open? ? "video" : (round.cancelled? ? "x" : "calendar")))) %></span>
        <div class="rs-body">
          <div class="row between" style="align-items:flex-start">
            <div>
              <b><%= round.name %></b>
              <% if round.assessment? %>
                <p class="tiny muted">
                  <%= round.task_label %> · <%= round.duration %> min · <%= round.total_marks %> marks
                  <%= " · #{pluralize(round.task_attachments.size, 'task file')}" if round.task_attachments.any? %>
                  <%= " · scores: #{round.score_parameters.join(', ')}" if round.score_parameters.any? %>
                </p>
              <% else %>
                <p class="tiny muted">
                  <%= round.scheduled_at ? round.scheduled_at.strftime("%a %d %b, %-I:%M %p") : "Not scheduled" %>
                  · scores: <%= round.score_parameters.join(", ") %>
                </p>
              <% end %>
            </div>
            <span class="badge round-badge-<%= round.status %>"><%= round.status_label %></span>
          </div>

          <% if round.assessment? %>
            <div class="rs-task-info">
              <% if round.working? %>
                <span class="pill live"><span class="live-dot"></span> Working · <%= round.seconds_left / 60 %> min left</span>
              <% elsif round.submitted? %>
                <span class="pill"><%= icon("upload") %> <%= pluralize(round.submissions.size, "file") %> submitted <%= nice_time(round.submitted_at) %></span>
              <% elsif round.open? %>
                <span class="pill"><%= icon("clock") %> Waiting for the candidate to start</span>
              <% end %>
              <% if round.graded? %>
                <span class="pill <%= round.passed? ? 'good' : 'bad' %>"><%= icon("award") %> <%= round.marks %>/<%= round.total_marks %> · <%= round.percentage %>% <%= round.passed? ? "Pass" : "Below cut-off" %></span>
              <% elsif round.submitted? %>
                <span class="pill warn"><%= icon("edit") %> Not marked yet</span>
              <% end %>
              <% warns = round.warnings_count %>
              <% if warns.positive? %><span class="rs-warn" title="Proctoring warnings during this assessment"><%= icon("alert") %> <%= warns %><%= "/#{round.warning_limit}" if round.warning_limit.positive? %></span><% end %>
              <% if round.allow_app_switch? %><span class="pill"><%= icon("unlock") %> App switching allowed</span><% end %>
            </div>
          <% else %>
            <div class="row wrap between" style="margin-top:.5rem">
              <div class="panel-stack" title="<%= round.panelists.map(&:name).join(', ').presence || 'No panelists' %>">
                <% scored = round.interview_feedbacks.map(&:employee_id) %>
                <% round.panelists.first(5).each do |p| %><span class="avatar <%= scored.include?(p.id) ? 'scored' : 'pending' %>" style="background: <%= gradient_for(p.name) %>" title="<%= p.name %> — <%= scored.include?(p.id) ? 'scored' : 'not scored yet' %>"><%= initials_for(p.name) %></span><% end %>
                <% if round.panelists.empty? %><span class="tiny muted">No panel</span><% end %>
              </div>
              <span class="tiny">
                <% warns = round.warnings_count %>
                <% if warns.positive? %><span class="rs-warn" title="Proctoring warnings during this round"><%= icon("alert") %> <%= warns %></span> · <% end %>
                <% if (avg = round.average) %><b class="rs-score"><%= avg %>/10</b> · <% end %>
                <%= pluralize(round.interview_feedbacks.size, "scorecard") %>
              </span>
            </div>
          <% end %>

          <div class="rs-actions">
            <% if round.assessment? %>
              <%= link_to room_invitation_interview_round_path(invitation, round), class: "btn #{round.working? || round.submitted? ? 'btn-primary' : 'btn-light'} btn-sm" do %>
                <%= icon(round.submitted? ? "award" : "eye") %> <%= round.submitted? ? (round.graded? ? "Marks & files" : "Check & give marks") : "Open live view" %>
              <% end %>
              <% if !round.open? && !round.submitted? && !round.cancelled? %>
                <%= button_to open_invitation_interview_round_path(invitation, round), class: "btn btn-primary btn-sm",
                      form: { data: { turbo_confirm: "Start “#{round.name}” for #{invitation.candidate_name}? They get the Start button on their link right away." } } do %><%= icon("play") %> Start now<% end %>
              <% end %>
              <% if round.submitted? %>
                <%= button_to reopen_invitation_interview_round_path(invitation, round), class: "btn btn-light btn-sm",
                      form: { data: { turbo_confirm: "Let #{invitation.candidate_name} do “#{round.name}” again? Their earlier uploads stay on record." } } do %><%= icon("play") %> Give another attempt<% end %>
              <% end %>
            <% elsif round.open? %>
              <%= link_to room_invitation_interview_round_path(invitation, round), class: "btn btn-primary btn-sm" do %><%= icon("video") %> Join room<% end %>
              <%= button_to complete_invitation_interview_round_path(invitation, round), class: "btn btn-light btn-sm", form: { data: { turbo_confirm: "End #{round.name}?" } } do %><%= icon("check") %> End round<% end %>
            <% elsif !round.cancelled? %>
              <%= button_to open_invitation_interview_round_path(invitation, round), class: "btn btn-primary btn-sm" do %><%= icon("play") %> <%= round.completed? ? "Re-open" : "Start now" %><% end %>
              <% if round.completed? %><%= link_to room_invitation_interview_round_path(invitation, round), class: "btn btn-light btn-sm" do %><%= icon("award") %> Scorecard<% end %><% end %>
            <% end %>
            <% if round.meeting_link.present? %><a class="btn btn-light btn-sm" href="<%= round.meeting_link %>" target="_blank" rel="noopener"><%= icon("link") %> Meet</a><% end %>

            <details class="rs-edit">
              <summary class="act-btn" title="Edit round"><%= icon("edit") %></summary>
              <%= form_with model: round, url: invitation_interview_round_path(invitation, round), method: :patch, class: "rs-form", multipart: true do |f| %>
                <div class="fields">
                  <div class="field"><%= f.label :name %><%= f.text_field :name, class: "input" %></div>
                  <div class="field"><%= f.label :scheduled_at, "Date & time" %><%= f.datetime_local_field :scheduled_at, class: "input" %></div>

                  <% if round.assessment? %>
                    <div class="field">
                      <%= f.label :assessment_id, "Saved assessment" %>
                      <%= f.select :assessment_id, assessments.map { |a| [ "#{a.title} (#{a.kind_label})", a.id ] }, { include_blank: "— only this round's own files —" }, class: "input" %>
                    </div>
                    <div class="field"><%= f.label :duration_minutes, "Time (minutes)" %><%= f.number_field :duration_minutes, min: 1, max: 600, class: "input", placeholder: round.duration %></div>
                    <div class="field"><%= f.label :max_marks, "Total marks" %><%= f.number_field :max_marks, min: 1, class: "input", placeholder: round.total_marks %></div>
                    <div class="field">
                      <%= f.label :max_warnings, "Auto-submit after" %>
                      <%= f.select :max_warnings, [ [ "3 warnings", 3 ], [ "5 warnings", 5 ], [ "8 warnings", 8 ], [ "10 warnings", 10 ], [ "Never (only alert)", 0 ] ], { include_blank: "Use the assessment's setting" }, class: "input" %>
                    </div>
                    <div class="field full">
                      <label class="switch"><%= f.check_box :allow_app_switch %><span><b>Candidate may open another app (Excel / Tally)</b><small>Tab / app-switch and full-screen warnings are paused; camera, phone and second-person checks plus screen recording keep running.</small></span></label>
                    </div>
                    <div class="field full">
                      <%= f.label :instructions, "Instructions for this candidate (leave empty to use the assessment's)" %>
                      <%= f.text_area :instructions, rows: 4, class: "input", placeholder: round.assessment&.instructions %>
                    </div>
                    <div class="field full">
                      <label>Task file(s) just for this candidate</label>
                      <% if round.task_files.attached? %>
                        <div class="file-list">
                          <% round.task_files.attachments.each do |file| %>
                            <div class="file-row">
                              <span class="file-ico"><%= icon("file") %></span>
                              <div class="grow"><b><%= file.filename %></b><span class="tiny muted"><%= number_to_human_size(file.byte_size) %></span></div>
                              <%= link_to rails_blob_path(file, disposition: "attachment"), class: "btn btn-light btn-sm", data: { turbo: false } do %><%= icon("download") %><% end %>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                      <%= f.file_field :task_files, multiple: true, class: "input" %>
                      <span class="hint">Uploaded here, these replace the saved assessment's files for this candidate only.</span>
                    </div>
                  <% end %>

                  <% unless round.assessment? %>
                    <div class="field full"><%= f.label :meeting_link, "Meet / Zoom link (optional)" %><%= f.url_field :meeting_link, class: "input", placeholder: "https://meet.google.com/…" %></div>
                  <% end %>
                  <div class="field full">
                    <label>Scores these stages</label>
                    <div class="chip-checks">
                      <% invitation.interview_parameters.each do |param| %>
                        <label><input type="checkbox" name="interview_round[parameters][]" value="<%= param %>" <%= "checked" if round.score_parameters.include?(param) %>><span><%= param %></span></label>
                      <% end %>
                      <input type="hidden" name="interview_round[parameters][]" value="">
                    </div>
                    <% if round.assessment? %><span class="hint">Tick a stage to make these marks count in the final weighted score.</span><% end %>
                  </div>
                  <% if employees.any? && !round.assessment? %>
                    <div class="field full" data-controller="combobox" data-combobox-placeholder-value="Panel for this round…">
                      <label>Panelists for this round</label>
                      <%= f.select :panelist_ids, options_for_select(employees.map { |e| [ e.name, e.id, { "data-sub" => e.subtitle } ] }, round.assigned_panelists.ids),
                            {}, multiple: true, class: "input", data: { combobox_target: "select" } %>
                      <span class="hint">Empty = candidate's panel (<%= invitation.panelists.map(&:name).join(", ").presence || "none" %>)</span>
                    </div>
                  <% end %>
                  <div class="field full">
                    <%= f.label :status %>
                    <%= f.select :status, InterviewRound::STATUSES.map { |k, v| [ v, k ] }, {}, class: "input" %>
                  </div>
                </div>
                <div class="row" style="justify-content:space-between;margin-top:.8rem">
                  <%= f.button class: "btn btn-primary btn-sm" do %><%= icon("check") %> Save round<% end %>
                </div>
              <% end %>
              <%= button_to invitation_interview_round_path(invitation, round), method: :delete, class: "btn btn-danger btn-sm", form: { class: "rs-delete", data: { turbo_confirm: "Delete #{round.name} and its scorecards?" } } do %><%= icon("trash") %> Delete round<% end %>
            </details>
          </div>
        </div>
      </li>
    <% end %>
  </ol>

  <div class="rs-add-row">
    <details class="rs-add">
      <summary class="btn btn-light btn-sm"><%= icon("plus") %> Add an interview round</summary>
      <%= form_with url: invitation_interview_rounds_path(invitation), scope: :interview_round, class: "rs-form" do |f| %>
        <%= f.hidden_field :kind, value: "interview" %>
        <div class="fields">
          <div class="field"><label>Round name</label><%= f.text_field :name, class: "input", required: true, placeholder: "e.g. Technical interview / Managerial round", list: "round-names-#{invitation.id}" %>
            <datalist id="round-names-<%= invitation.id %>"><% (invitation.interview_parameters + [ "Managerial round", "Final round" ]).uniq.each do |n| %><option value="<%= n %>"><% end %></datalist>
          </div>
          <div class="field"><label>Date & time</label><%= f.datetime_local_field :scheduled_at, class: "input" %></div>
          <div class="field full">
            <label>Scores these stages</label>
            <div class="chip-checks">
              <% invitation.interview_parameters.each do |param| %>
                <label><input type="checkbox" name="interview_round[parameters][]" value="<%= param %>"><span><%= param %></span></label>
              <% end %>
            </div>
            <span class="hint">None ticked = the stage with the same name as the round (or all stages).</span>
          </div>
        </div>
        <%= f.button class: "btn btn-primary btn-sm", style: "margin-top:.8rem" do %><%= icon("plus") %> Add round<% end %>
      <% end %>
    </details>

    <details class="rs-add">
      <summary class="btn btn-light btn-sm"><%= icon("sheet") %> Add a practical assessment</summary>
      <%= form_with url: invitation_interview_rounds_path(invitation), scope: :interview_round, class: "rs-form", multipart: true do |f| %>
        <%= f.hidden_field :kind, value: "assessment" %>
        <p class="small muted" style="margin:0 0 .8rem">
          A live task the candidate solves on screen — Excel, Tally, Word, data entry, coding… fully proctored (camera, screen share, warnings).
          Pick a saved one, or upload the file right here for this candidate only.
        </p>
        <div class="fields">
          <div class="field full">
            <label>Saved assessment</label>
            <%= f.select :assessment_id, assessments.map { |a| [ "#{a.title} — #{a.kind_label} · #{a.duration_minutes} min · #{a.max_marks} marks", a.id ] },
                  { include_blank: assessments.any? ? "— upload a file below instead —" : "— no saved assessment yet —" }, class: "input" %>
            <span class="hint"><%= link_to "Manage practical assessments", assessments_path %> to reuse the same task for every candidate.</span>
          </div>
          <div class="field"><label>Round name</label><%= f.text_field :name, class: "input", placeholder: "e.g. Excel practical test" %>
            <span class="hint">Empty = the assessment's own name.</span>
          </div>
          <div class="field"><label>Date & time (optional)</label><%= f.datetime_local_field :scheduled_at, class: "input" %></div>
          <div class="field"><label>Time (minutes)</label><%= f.number_field :duration_minutes, min: 1, max: 600, class: "input", placeholder: "from the assessment" %></div>
          <div class="field"><label>Total marks</label><%= f.number_field :max_marks, min: 1, class: "input", placeholder: "from the assessment" %></div>
          <div class="field full">
            <label>Task file(s) for this candidate</label>
            <%= f.file_field :task_files, multiple: true, class: "input" %>
            <span class="hint">Excel, Tally backup, Word, PDF, ZIP… Needed only if you did not pick a saved assessment above.</span>
          </div>
          <div class="field full">
            <label>Instructions for the candidate</label>
            <%= f.text_area :instructions, rows: 3, class: "input", placeholder: "Step by step: what to open, what to do, what to upload back." %>
          </div>
          <div class="field full">
            <label class="switch"><%= f.check_box :allow_app_switch %><span><b>Candidate may open another app (Excel / Tally)</b><small>Needed when the task is done outside the browser. Their screen stays shared and recorded.</small></span></label>
          </div>
          <div class="field full">
            <label>Scores these stages (optional)</label>
            <div class="chip-checks">
              <% invitation.interview_parameters.each do |param| %>
                <label><input type="checkbox" name="interview_round[parameters][]" value="<%= param %>"><span><%= param %></span></label>
              <% end %>
            </div>
            <span class="hint">Tick a stage to make these marks count in the candidate's final weighted score.</span>
          </div>
        </div>
        <%= f.button class: "btn btn-primary btn-sm", style: "margin-top:.8rem" do %><%= icon("plus") %> Add practical assessment<% end %>
      <% end %>
    </details>
  </div>
</div>
