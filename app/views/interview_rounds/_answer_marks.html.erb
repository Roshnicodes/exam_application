<%# The answer sheet marked from the answer key: the application's marks and the reviewers' marks side by side.
    HR (or a panelist on the watch link — department / thematic head) can change any question's marks.
    locals: round:, invitation:, watch_token: (panelist view), panelists: %>
<% if round.answer_sheet? %>
  <% marks = round.item_marks %>
  <% fmt = ->(n) { number_with_precision(n.to_f, precision: 1, strip_insignificant_zeros: true) } %>
  <% editable = round.submitted? %>
  <% url = local_assigns[:watch_token] ? watch_marks_path(watch_token, round) : mark_items_invitation_interview_round_path(invitation, round) %>
  <div class="answer-marks" id="answer-sheet">
    <b class="small am-title"><%= icon("check-circle") %> Answer sheet · marked from the answer key</b>
    <div class="am-summary">
      <div class="am-total">
        <span>Application</span>
        <b><%= marks.any? ? "#{fmt.(round.auto_score)} / #{fmt.(round.key_total)}" : "—" %></b>
      </div>
      <div class="am-total final">
        <span>Final<%= " (after review)" if round.changed_by.any? %></span>
        <b><%= marks.any? ? "#{fmt.(round.sheet_score)} / #{fmt.(round.key_total)}" : "—" %></b>
      </div>
      <div class="am-meta tiny muted">
        <% if marks.empty? %>
          <%= round.answered_count %> / <%= round.answer_items.size %> answered<%= " so far" if round.working? %>
        <% else %>
          <% if round.to_review_count.positive? %><span class="state-pill" style="background:#fef3c7;color:#92400e"><%= round.to_review_count %> written to check</span><% end %>
          <% if round.changed_by.any? %>Changed by <b><%= round.changed_by.to_sentence %></b><% else %>Not reviewed yet<% end %>
        <% end %>
      </div>
    </div>

    <%= form_with url: url, class: "am-form" do %>
      <% if local_assigns[:watch_token] && editable %>
        <div class="am-who">
          <% if Array(local_assigns[:panelists]).any? %>
            <label for="am_employee">Marking as</label>
            <%= select_tag :employee_id, options_for_select(panelists.map { |p| [ p.name, p.id ] }), prompt: "Choose your name", class: "input input-sm", id: "am_employee" %>
            <span class="tiny muted">or</span>
          <% end %>
          <%= text_field_tag :reviewer_name, nil, class: "input input-sm", placeholder: "Your name (e.g. Head – Finance)" %>
        </div>
      <% end %>
      <div class="table-wrap">
        <table class="table am-table">
          <thead><tr><th>Q</th><th>Candidate's answer</th><th>Correct / key points</th><th class="num">App</th><th class="num">Final</th></tr></thead>
          <tbody>
            <% round.answer_items.each do |item| %>
              <% m = marks[item["id"]] || {} %>
              <% given = round.answers[item["id"]].to_s %>
              <% auto = m.key?("auto") ? m["auto"] : m["marks"] %>
              <tr class="<%= 'am-ok' if m['correct'] == true %> <%= 'am-bad' if m['correct'] == false && given.present? %> <%= 'am-changed' if m['by_hr'] %>">
                <td><b><%= item["label"] %></b><% if item["title"].present? %><div class="tiny muted"><%= truncate(item["title"], length: 60) %></div><% end %></td>
                <td class="am-given"><%= given.present? ? simple_format(truncate(given, length: 900)) : content_tag(:span, "Not answered", class: "tiny muted") %></td>
                <td class="small">
                  <% if item["kind"] == "text" %>
                    <% matched = Array(m["matched"]) %>
                    <div class="key-terms"><% Array(item["terms"]).each do |t| %><span class="chip <%= 'hit' if matched.include?(t) %>"><%= AnswerKey.term_label(t) %></span><% end %></div>
                    <% if item["rubric"].present? %><div class="tiny muted" style="margin-top:.3rem">Marking: <%= truncate(item["rubric"], length: 160) %></div><% end %>
                  <% else %>
                    <b><%= item["answer"] %></b>
                  <% end %>
                </td>
                <td class="num am-app"><%= m.empty? ? "—" : fmt.(auto) %><% if m["review"] && !m["by_hr"] %><div class="tiny" style="color:#b45309">check</div><% end %></td>
                <td class="num">
                  <% if editable %>
                    <span class="am-mark">
                      <%= number_field_tag "marks[#{item['id']}]", (m.key?("marks") ? fmt.(m["marks"]) : nil), step: 0.5, min: 0, max: item["marks"], class: "input input-sm", style: "width:4.4rem", placeholder: "—", "aria-label": "Marks for #{item['label']}" %>
                      <span class="tiny muted">/ <%= fmt.(item["marks"]) %></span>
                    </span>
                  <% else %>
                    <%= m.key?("marks") ? fmt.(m["marks"]) : "—" %> / <%= fmt.(item["marks"]) %>
                  <% end %>
                  <% if m["by_hr"] && m["by"].present? %><div class="tiny muted" title="<%= m['at'] %>">by <%= m["by"] %></div><% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if editable %>
        <div class="row between" style="margin-top:.8rem;flex-wrap:wrap;gap:.5rem">
          <span class="tiny muted">Change any mark and save — the final total and result update; the application's marks stay as they were.</span>
          <button type="submit" class="btn btn-primary btn-sm"><%= icon("check") %> Save marks</button>
        </div>
      <% end %>
    <% end %>
    <% if editable && local_assigns[:watch_token].nil? %>
      <%= button_to remark_invitation_interview_round_path(invitation, round), class: "btn btn-light btn-sm", form: { style: "margin-top:.2rem", data: { turbo_confirm: "Mark again from the answer key? Marks changed by reviewers are kept." } } do %><%= icon("activity") %> Mark again from the key<% end %>
    <% end %>
  </div>
<% end %>
