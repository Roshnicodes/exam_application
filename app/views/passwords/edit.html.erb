<% content_for :title, "Reset password" %>
<h2>Set a new password</h2>
<p>Choose a strong password you don't use elsewhere.</p>
<%= form_with url: password_path(params[:token]), method: :put, class: "stack" do |form| %>
  <div class="field"><label>New password</label><%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %></div>
  <div class="field"><label>Confirm password</label><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %></div>
  <%= form.button "Save password", class: "btn btn-primary btn-lg btn-block" %>
<% end %>
