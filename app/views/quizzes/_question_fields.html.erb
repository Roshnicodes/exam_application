<% opts = (Array(f.object.options) + [ "", "", "", "" ]).first([ Array(f.object.options).size, 4 ].max) %>
<% needs_answer = f.object.body.present? && f.object.correct_index.nil? %>
<div class="q-builder <%= 'needs-answer' if needs_answer %>" data-nested-form-target="item">
  <%= f.hidden_field :id if f.object.persisted? %>
  <%= f.hidden_field :_destroy, data: { nested_form_target: "destroy" } %>
  <%= f.hidden_field :position, data: { nested_form_target: "position" } %>
  <div class="row" style="align-items:flex-start">
    <span class="q-num" data-nested-form-target="number">#</span>
    <div class="grow">
      <% if needs_answer %><div class="needs-answer-note"><%= icon("alert") %> Choose the correct answer — tick the circle next to the right option</div><% end %>
      <%= f.text_area :body, rows: [ f.object.body.to_s.lines.size + 1, 2 ].max.clamp(2, 12), placeholder: "Type the question…", class: "input" %>
      <div class="opt-grid">
        <% opts.each_with_index do |opt, i| %>
          <label class="opt-input">
            <span class="letter"><%= Question::LETTERS[i] %></span>
            <input type="text" name="<%= f.object_name %>[options][]" value="<%= opt %>" placeholder="Option <%= Question::LETTERS[i] %>">
            <%= f.radio_button :correct_index, i, title: "Mark as correct answer" %>
          </label>
        <% end %>
      </div>
      <% hi = (Array(f.object.options_hi) + Array.new(opts.size, "")).first(opts.size) %>
      <details class="q-hindi" <%= "open" if f.object.body_hi.present? %>>
        <summary><span class="q-hindi-mark">अ</span> Hindi version <small><%= f.object.hindi? ? "✓ ready" : "optional — for candidates taking the test in Hindi" %></small></summary>
        <%= f.text_area :body_hi, rows: [ f.object.body_hi.to_s.lines.size + 1, 2 ].max.clamp(2, 12), placeholder: "प्रश्न हिंदी में लिखें…", class: "input" %>
        <div class="opt-grid">
          <% hi.each_with_index do |opt, i| %>
            <label class="opt-input"><span class="letter"><%= Question::LETTERS[i] %></span>
              <input type="text" name="<%= f.object_name %>[options_hi][]" value="<%= opt %>" placeholder="विकल्प <%= Question::LETTERS[i] %>">
            </label>
          <% end %>
        </div>
      </details>
      <div class="row" style="margin-top:.75rem">
        <span class="small muted">Marks</span>
        <%= f.number_field :marks, min: 1, max: 20, class: "input", style: "width:90px;padding:.45rem .7rem" %>
        <span class="grow"></span>
        <button type="button" class="btn btn-danger btn-sm" data-action="nested-form#remove"><%= icon("trash") %> Remove</button>
      </div>
    </div>
  </div>
</div>
