<% content_for :title, "#{@round.name} in progress" %>
<%= turbo_stream_from @invitation, :candidate %>
<div id="exam_control" hidden></div>
<% files = @round.submissions.attachments.to_a %>
<% online_sheet = @round.online_sheet? %>
<% answer_sheet = @round.answer_sheet? %>
<%# a test with an answer key: the question paper stays open next to the answer sheet %>
<% paper = answer_sheet ? @round.task_attachments.find { |f| Assessment::PAPER_EXTENSIONS.include?(f.filename.extension_with_delimiter.downcase) } : nil %>
<% auto_saved = online_sheet || answer_sheet %>
<div data-controller="assessment proctor"
     data-assessment-seconds-left-value="<%= @round.seconds_left %>"
     data-assessment-notes-url-value="<%= exam_assessment_notes_path(@invitation.token) %>"
     data-assessment-files-url-value="<%= exam_assessment_files_path(@invitation.token) %>"
     data-assessment-remove-url-value="<%= exam_assessment_remove_file_path(@invitation.token, "__ID__") %>"
     data-assessment-require-upload-value="<%= @round.require_upload? && !auto_saved %>"
     data-assessment-files-value="<%= files.size %>"
     data-assessment-max-files-value="<%= Assessment::MAX_FILES %>"
     data-assessment-app-switch-value="<%= @round.allow_app_switch? %>"
     data-proctor-events-url-value="<%= exam_events_path(@invitation.token) %>"
     data-proctor-recordings-url-value="<%= exam_recordings_path(@invitation.token) %>"
     data-proctor-warnings-value="<%= @round.warnings_count %>"
     data-proctor-max-warnings-value="<%= @round.warning_limit %>"
     data-proctor-token-value="<%= @invitation.token %>"
     data-proctor-round-value="<%= @round.id %>"
     data-proctor-mode-value="assessment"
     data-proctor-allow-switch-value="<%= @round.allow_app_switch? %>"
     data-action="proctor:terminated->assessment#forceSubmit assessment:before-submit->proctor#finish">

  <header class="exam-top">
    <%= render "shared/brand" %>
    <div class="grow hide-sm" style="text-align:center">
      <b><%= @invitation.candidate_name %></b>
      <div class="tiny muted"><%= @round.name %> · <%= @round.total_marks %> marks · <% if auto_saved %>auto-saved<% else %><span data-assessment-target="fileCount"><%= files.size %></span> file(s) uploaded<% end %></div>
    </div>
    <span class="grow" style="display:none"></span>
    <span class="warn-meter" title="Warnings"><%= icon("alert") %> <span data-proctor-target="warnLabel"><%= @round.warnings_count %><%= "/#{@round.warning_limit}" if @round.warning_limit.positive? %></span></span>
    <span class="timer" data-assessment-target="timer"><%= icon("clock") %> <span data-assessment-target="clock">--:--</span></span>
    <button type="button" class="btn btn-primary btn-sm" data-action="assessment#confirmSubmit" data-assessment-target="submitButton"><%= icon("send") %><span class="hide-sm">Submit work</span></button>
  </header>

  <div class="exam-layout <%= 'exam-layout-sheet' if online_sheet %> <%= 'exam-layout-paper' if paper %>">
    <div class="stack">
      <%# ---------------- the task ---------------- %>
      <section class="card card-pad task-card">
        <div class="row between" style="align-items:flex-start">
          <div>
            <span class="badge" style="background:var(--brand-soft);color:var(--brand)"><%= icon(@round.task_icon) %> <%= @round.task_label %></span>
            <h2 style="margin-top:.6rem;font-size:1.25rem"><%= @round.name %></h2>
          </div>
          <span class="pill"><%= icon("award") %> <%= @round.total_marks %> marks</span>
        </div>

        <% task_files = @round.task_attachments.reject { |f| (online_sheet && f.id == @round.sheet_task_file&.id) || f.id == paper&.id } %>
        <% if task_files.any? %>
          <div class="task-files">
            <b class="small"><%= icon("download") %> <%= online_sheet || paper ? "Other task file(s) — for reference" : (@round.allow_download? ? "Your task file(s) — open / download and work on them" : "Task file(s) — view only") %></b>
            <% task_files.each do |file| %>
              <div class="file-row">
                <span class="file-ico"><%= icon("file") %></span>
                <div class="grow"><b><%= file.filename %></b><span class="tiny muted"><%= number_to_human_size(file.byte_size) %></span></div>
                <% kind = task_preview_kind(file) %>
                <button type="button" class="btn btn-light btn-sm" data-action="assessment#preview" data-name="<%= file.filename %>" data-kind="<%= kind %>"
                        data-src="<%= kind.in?(%w[sheet doc]) ? exam_assessment_task_preview_path(@invitation.token, file.id) : rails_blob_path(file, disposition: "inline") %>"><%= icon("eye") %> View</button>
                <% if @round.allow_download? %>
                  <%= link_to rails_blob_path(file, disposition: "attachment"), class: "btn btn-primary btn-sm", data: { turbo: false } do %><%= icon("download") %> Download<% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if @round.task_instructions.present? %>
          <div class="task-text" style="margin-top:1rem"><%= simple_format(@round.task_instructions) %></div>
        <% else %>
          <p class="small muted" style="margin-top:1rem"><%= if paper then "Read each question in the paper and answer it on the answer sheet — one question at a time; use Next to move on." elsif answer_sheet then "Answer each question on the answer sheet below." elsif online_sheet then "Fill the answer sheet below — it works like Excel." else "Work on the file above." end %> If anything is unclear, ask HR in the chat (the video call button at the bottom right).</p>
        <% end %>

        <% if @round.allow_app_switch? %>
          <p class="task-note ok"><%= icon("unlock") %> You may open <b><%= @round.task_label %></b> or another app to do this task — your screen stays shared with HR.<%= " Come back to this page to upload your file." unless auto_saved %></p>
        <% else %>
          <p class="task-note"><%= icon("alert") %> Stay on this page in full screen. Switching tabs or apps gives a warning<%= " (#{@round.warning_limit} warnings end the assessment)" if @round.warning_limit.positive? %>.</p>
        <% end %>
      </section>

      <%# ---------------- answer sheet (practical tests with an answer key) ---------------- %>
      <% if paper %>
        <div class="qp-split">
          <%= render "exams/question_paper", paper: paper, invitation: @invitation %>
          <%= render "exams/answer_sheet", round: @round, invitation: @invitation %>
        </div>
      <% elsif answer_sheet %>
        <%= render "exams/answer_sheet", round: @round, invitation: @invitation %>
      <% end %>

      <%# ---------------- the built-in spreadsheet: the task sheet, filled right here ---------------- %>
      <% if online_sheet %>
<% xl_paths = { "paste" => '<rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4V3h6v1M9 9h6M9 13h6M9 17h3"/>', "cut" => '<circle cx="6" cy="18" r="3"/><circle cx="18" cy="18" r="3"/><path d="M8.5 16 18 4M15.5 16 6 4"/>', "copy" => '<rect x="8" y="8" width="12" height="13" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h2"/>', "bucket" => '<path d="m5 11 7-7 7 7-7 7z"/><path d="M19 15s2 2.3 2 3.5a2 2 0 0 1-4 0c0-1.2 2-3.5 2-3.5z"/>', "left" => '<path d="M4 6h16M4 10h10M4 14h16M4 18h10"/>', "center" => '<path d="M4 6h16M7 10h10M4 14h16M7 18h10"/>', "right" => '<path d="M4 6h16M10 10h10M4 14h16M10 18h10"/>', "wrap" => '<path d="M4 6h16M4 12h13a3 3 0 0 1 0 6h-4m2-2-2 2 2 2M4 18h5"/>', "rowadd" => '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 12h18M12 15v4M10 17h4"/>', "coladd" => '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M12 4v16M15 12h4M17 10v4"/>', "rowdel" => '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 12h18M10 17h4"/>', "coldel" => '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M12 4v16M15 12h4"/>', "sigma" => '<path d="M18 5H6l6 7-6 7h12"/>', "filldown" => '<path d="M12 4v13m-5-5 5 5 5-5M5 20h14"/>', "fillright" => '<path d="M4 12h13m-5-5 5 5-5 5M20 5v14"/>', "eraser" => '<path d="m7 21-4-4 10-10 7 7-6 7z"/><path d="M14 21h7"/>', "sortaz" => '<path d="M4 6h7M4 12h5M4 18h3M17 4v16m-3-3 3 3 3-3"/>', "sortza" => '<path d="M4 6h3M4 12h5M4 18h7M17 20V4m-3 3 3-3 3 3"/>', "zoomin" => '<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4M8 11h6M11 8v6"/>', "zoomout" => '<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4M8 11h6"/>', "expand" => '<path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/>', "help" => '<circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .9-1 1.7M12 17h.01"/>', "undo" => '<path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/>', "redo" => '<path d="m15 14 5-5-5-5"/><path d="M20 9H9a5 5 0 0 0 0 10h3"/>', "fx" => '<path d="M7 20c2 0 2-2 2.5-6S11 4 14 4M6 11h7M14 13l5 6M19 13l-5 6"/>' } %>
<% xi = ->(name) { raw(%(<svg class="xli" viewBox="0 0 24 24" aria-hidden="true">#{xl_paths[name]}</svg>)) } %>
        <% task_name = @round.sheet_task_file&.filename.to_s.presence || "Book1.xlsx" %>
        <section class="card sx" data-controller="sheet-editor" data-sheet-editor
                 data-sheet-editor-url-value="<%= exam_assessment_sheet_path(@invitation.token) %>"
                 data-sheet-editor-save-url-value="<%= exam_assessment_sheet_save_path(@invitation.token) %>">
          <%# title bar, like Excel's %>
          <div class="xl-title">
            <span class="xl-logo">X</span>
            <span class="xl-save hide-sm"><span class="xl-dot"></span> AutoSave <b>On</b></span>
            <button type="button" class="xl-q" title="Undo (Ctrl+Z)" data-action="sheet-editor#undo"><%= xi.("undo") %></button>
            <button type="button" class="xl-q" title="Redo (Ctrl+Y)" data-action="sheet-editor#redo"><%= xi.("redo") %></button>
            <span class="xl-file"><%= task_name %> <span class="xl-saved" data-sheet-editor-target="status">Saved</span></span>
            <span class="grow"></span>
            <button type="button" class="xl-q wide" data-action="sheet-editor#toggleHelp"><%= xi.("help") %><span class="hide-sm">Help</span></button>
            <button type="button" class="xl-q wide" data-action="sheet-editor#expand" title="Use the whole screen"><%= xi.("expand") %><span class="hide-sm">Full view</span></button>
          </div>

          <%# ribbon %>
          <div class="xl-tabs">
            <button type="button" class="active" data-ribbon-tab="home" data-tab="home" data-action="sheet-editor#ribbonTab">Home</button>
            <button type="button" data-ribbon-tab="formulas" data-tab="formulas" data-action="sheet-editor#ribbonTab">Formulas</button>
            <button type="button" data-ribbon-tab="data" data-tab="data" data-action="sheet-editor#ribbonTab">Data</button>
            <button type="button" data-ribbon-tab="view" data-tab="view" data-action="sheet-editor#ribbonTab">View</button>
          </div>
          <div class="xl-ribbon" data-sheet-editor-target="ribbon">
            <div class="xl-panel" data-ribbon-panel="home">
              <div class="xl-group">
                <div class="xl-row">
                  <button type="button" class="xl-big" data-action="sheet-editor#paste" title="Paste (Ctrl+V)"><span class="xl-ico"><%= xi.("paste") %></span>Paste</button>
                  <div class="xl-col">
                    <button type="button" data-action="sheet-editor#cutCells" title="Cut (Ctrl+X)"><%= xi.("cut") %> <span class="xl-t">Cut</span></button>
                    <button type="button" data-action="sheet-editor#copyCells" title="Copy (Ctrl+C)"><%= xi.("copy") %> <span class="xl-t">Copy</span></button>
                  </div>
                </div>
                <span class="xl-glabel">Clipboard</span>
              </div>
              <div class="xl-group">
                <div class="xl-col">
                  <div class="xl-row">
                    <select class="xl-font" disabled title="Font"><option>Calibri</option></select>
                    <select class="xl-size" data-sheet-editor-target="fontSize" data-action="change->sheet-editor#fontSize" title="Font size">
                      <% [ 8, 9, 10, 11, 12, 14, 16, 18, 20, 24, 28 ].each do |n| %><option value="<%= n %>" <%= "selected" if n == 11 %>><%= n %></option><% end %>
                    </select>
                  </div>
                  <div class="xl-row">
                    <button type="button" class="xl-ic" data-state="b" data-action="sheet-editor#bold" title="Bold (Ctrl+B)"><b>B</b></button>
                    <button type="button" class="xl-ic" data-state="i" data-action="sheet-editor#italic" title="Italic (Ctrl+I)"><i>I</i></button>
                    <button type="button" class="xl-ic" data-state="u" data-action="sheet-editor#underline" title="Underline (Ctrl+U)"><u>U</u></button>
                    <span class="xl-split">
                      <button type="button" class="xl-ic" data-kind="bg" data-action="sheet-editor#applyLastColor" title="Fill color"><span class="xl-fill"><%= xi.("bucket") %></span></button>
                      <button type="button" class="xl-drop" data-palette="bg" data-action="sheet-editor#openPalette" title="Fill colors">▾</button>
                    </span>
                    <span class="xl-split">
                      <button type="button" class="xl-ic" data-kind="fc" data-action="sheet-editor#applyLastColor" title="Font color"><span class="xl-a">A</span></button>
                      <button type="button" class="xl-drop" data-palette="fc" data-action="sheet-editor#openPalette" title="Font colors">▾</button>
                    </span>
                  </div>
                </div>
                <span class="xl-glabel">Font</span>
              </div>
              <div class="xl-group">
                <div class="xl-col">
                  <div class="xl-row">
                    <button type="button" class="xl-ic" data-state="al:left" data-align="left" data-action="sheet-editor#align" title="Align left"><%= xi.("left") %></button>
                    <button type="button" class="xl-ic" data-state="al:center" data-align="center" data-action="sheet-editor#align" title="Center"><%= xi.("center") %></button>
                    <button type="button" class="xl-ic" data-state="al:right" data-align="right" data-action="sheet-editor#align" title="Align right"><%= xi.("right") %></button>
                  </div>
                  <div class="xl-row">
                    <button type="button" class="xl-ic wide" data-state="w" data-action="sheet-editor#wrapText" title="Wrap text"><%= xi.("wrap") %> <span class="xl-t">Wrap Text</span></button>
                  </div>
                </div>
                <span class="xl-glabel">Alignment</span>
              </div>
              <div class="xl-group">
                <div class="xl-col">
                  <div class="xl-row">
                    <select class="xl-numfmt" data-sheet-editor-target="numberFormat" data-action="change->sheet-editor#numberFormat" title="Number format">
                      <option value="general">General</option><option value="number">Number</option><option value="currency">Currency (₹)</option>
                      <option value="comma">Comma</option><option value="percent">Percentage</option>
                    </select>
                  </div>
                  <div class="xl-row">
                    <button type="button" class="xl-ic" data-action="sheet-editor#currency" title="Currency ₹">₹</button>
                    <button type="button" class="xl-ic" data-action="sheet-editor#percent" title="Percent style">%</button>
                    <button type="button" class="xl-ic" data-action="sheet-editor#comma" title="Comma style">,</button>
                    <button type="button" class="xl-ic" data-step="1" data-action="sheet-editor#decimals" title="Increase decimal">.0→</button>
                    <button type="button" class="xl-ic" data-step="-1" data-action="sheet-editor#decimals" title="Decrease decimal">←.0</button>
                  </div>
                </div>
                <span class="xl-glabel">Number</span>
              </div>
              <div class="xl-group">
                <div class="xl-col">
                  <button type="button" data-action="sheet-editor#insertRows" title="Insert row above"><%= xi.("rowadd") %> <span class="xl-t">Insert row</span></button>
                  <button type="button" data-action="sheet-editor#insertCols" title="Insert column left"><%= xi.("coladd") %> <span class="xl-t">Insert column</span></button>
                </div>
                <div class="xl-col">
                  <button type="button" data-action="sheet-editor#deleteRows" title="Delete row"><%= xi.("rowdel") %> <span class="xl-t">Delete row</span></button>
                  <button type="button" data-action="sheet-editor#deleteCols" title="Delete column"><%= xi.("coldel") %> <span class="xl-t">Delete column</span></button>
                </div>
                <span class="xl-glabel">Cells</span>
              </div>
              <div class="xl-group">
                <div class="xl-row">
                  <button type="button" class="xl-big" data-action="sheet-editor#autoSum" title="AutoSum (Alt+=)"><span class="xl-ico"><%= xi.("sigma") %></span>AutoSum</button>
                  <div class="xl-col">
                    <button type="button" data-action="sheet-editor#fillDown" title="Fill down (Ctrl+D)"><%= xi.("filldown") %> <span class="xl-t">Fill</span></button>
                    <button type="button" data-action="sheet-editor#clearAll" title="Clear contents and formats"><%= xi.("eraser") %> <span class="xl-t">Clear</span></button>
                    <button type="button" data-action="sheet-editor#sortAsc" title="Sort A to Z"><%= xi.("sortaz") %> <span class="xl-t">Sort</span></button>
                  </div>
                </div>
                <span class="xl-glabel">Editing</span>
              </div>
            </div>

            <div class="xl-panel" data-ribbon-panel="formulas" hidden>
              <div class="xl-group">
                <div class="xl-row">
                  <button type="button" class="xl-big" data-action="sheet-editor#autoSum"><span class="xl-ico"><%= xi.("sigma") %></span>AutoSum</button>
                  <div class="xl-fns">
                    <% %w[SUM AVERAGE COUNT COUNTA MAX MIN ROUND IF IFERROR AND OR].each do |fn| %>
                      <button type="button" data-fn="<%= fn %>" data-action="sheet-editor#insertFunction"><%= fn %></button>
                    <% end %>
                  </div>
                </div>
                <span class="xl-glabel">Math &amp; Logical</span>
              </div>
              <div class="xl-group">
                <div class="xl-fns">
                  <% %w[VLOOKUP HLOOKUP XLOOKUP INDEX MATCH SUMIF SUMIFS COUNTIF COUNTIFS AVERAGEIF SUMPRODUCT].each do |fn| %>
                    <button type="button" data-fn="<%= fn %>" data-action="sheet-editor#insertFunction"><%= fn %></button>
                  <% end %>
                </div>
                <span class="xl-glabel">Lookup &amp; Conditional</span>
              </div>
              <div class="xl-group">
                <div class="xl-fns">
                  <% %w[CONCAT LEFT RIGHT MID LEN UPPER LOWER PROPER TRIM TEXT TODAY DATE YEAR MONTH DAY].each do |fn| %>
                    <button type="button" data-fn="<%= fn %>" data-action="sheet-editor#insertFunction"><%= fn %></button>
                  <% end %>
                </div>
                <span class="xl-glabel">Text &amp; Date</span>
              </div>
            </div>

            <div class="xl-panel" data-ribbon-panel="data" hidden>
              <div class="xl-group">
                <div class="xl-row">
                  <button type="button" class="xl-big" data-action="sheet-editor#sortAsc"><span class="xl-ico"><%= xi.("sortaz") %></span>Sort A to Z</button>
                  <button type="button" class="xl-big" data-action="sheet-editor#sortDesc"><span class="xl-ico"><%= xi.("sortza") %></span>Sort Z to A</button>
                </div>
                <span class="xl-glabel">Sort</span>
              </div>
              <div class="xl-group">
                <div class="xl-col">
                  <button type="button" data-action="sheet-editor#fillDown"><%= xi.("filldown") %> Fill down (Ctrl+D)</button>
                  <button type="button" data-action="sheet-editor#fillRight"><%= xi.("fillright") %> Fill right (Ctrl+R)</button>
                </div>
                <span class="xl-glabel">Fill</span>
              </div>
            </div>

            <div class="xl-panel" data-ribbon-panel="view" hidden>
              <div class="xl-group">
                <div class="xl-row">
                  <button type="button" class="xl-big" data-action="sheet-editor#zoomOut"><span class="xl-ico"><%= xi.("zoomout") %></span>Zoom out</button>
                  <button type="button" class="xl-big" data-action="sheet-editor#zoomIn"><span class="xl-ico"><%= xi.("zoomin") %></span>Zoom in</button>
                  <button type="button" class="xl-big" data-action="sheet-editor#expand"><span class="xl-ico"><%= xi.("expand") %></span>Full view</button>
                </div>
                <span class="xl-glabel">Zoom</span>
              </div>
            </div>
          </div>
          <div class="sx-help" data-sheet-editor-target="help" hidden></div>

          <%# name box + formula bar %>
          <div class="sx-bar">
            <input class="sx-name" data-sheet-editor-target="name" value="A1" spellcheck="false" autocomplete="off"
                   data-action="keydown->sheet-editor#goto" aria-label="Name box" title="Name box — type a cell (e.g. G14) and press Enter">
            <span class="sx-fxicons"><span class="hide-sm">✕ ✓</span> <%= xi.("fx") %></span>
            <input type="text" class="sx-formula" data-sheet-editor-target="formula" spellcheck="false" autocomplete="off"
                   data-action="keydown->sheet-editor#formulaKey input->sheet-editor#formulaInput" aria-label="Formula bar">
          </div>

          <div class="sx-wrap" data-sheet-editor-target="wrap" data-action="pointerdown->sheet-editor#handleDown scroll->sheet-editor#placeFrame">
            <table class="sx-grid" tabindex="0" data-sheet-editor-target="grid"
                   data-action="mousedown->sheet-editor#mousedown mouseover->sheet-editor#mouseover dblclick->sheet-editor#dblclick contextmenu->sheet-editor#contextmenu"></table>
          </div>

          <div class="sx-foot">
            <span class="sx-nav">◀ ▶</span>
            <div class="sx-tabs" data-sheet-editor-target="tabs"></div>
          </div>
          <div class="xl-status">
            <span data-sheet-editor-target="mode">Ready</span>
            <span class="grow"></span>
            <span class="xl-stats" data-sheet-editor-target="stats"></span>
            <button type="button" data-action="sheet-editor#zoomOut" title="Zoom out">－</button>
            <span class="xl-zoom" data-sheet-editor-target="zoomLabel">100%</span>
            <button type="button" data-action="sheet-editor#zoomIn" title="Zoom in">＋</button>
          </div>

          <%# right-click menu + colour palette %>
          <div class="sx-menu" data-sheet-editor-target="menu" hidden>
            <% [ [ "cutCells", "Cut", "Ctrl+X" ], [ "copyCells", "Copy", "Ctrl+C" ], [ "paste", "Paste", "Ctrl+V" ], nil,
                 [ "insertRows", "Insert row above", "" ], [ "insertCols", "Insert column left", "" ], [ "deleteRows", "Delete row", "" ], [ "deleteCols", "Delete column", "" ], nil,
                 [ "clearSelection", "Clear contents", "Del" ], [ "clearAll", "Clear all (formats too)", "" ], nil,
                 [ "sortAsc", "Sort A → Z", "" ], [ "sortDesc", "Sort Z → A", "" ], [ "fillDown", "Fill down", "Ctrl+D" ] ].each do |item| %>
              <% if item %><button type="button" data-do="<%= item[0] %>" data-action="sheet-editor#menuAction"><span><%= item[1] %></span><small><%= item[2] %></small></button><% else %><hr><% end %>
            <% end %>
          </div>
          <div class="sx-palette" data-sheet-editor-target="palette" hidden></div>
        </section>
      <% end %>

      <%# ---------------- the candidate's work ---------------- %>
      <section class="card card-pad work-card <%= 'finish-card-sheet' if online_sheet %>">
        <% if auto_saved %>
          <%# the answer sheet / built-in Excel saves and submits by itself — nothing to upload %>
          <div class="auto-save-note">
            <span class="as-ico"><%= icon("check-circle") %></span>
            <div>
              <b>No upload needed — your work is saved automatically</b>
              <% if online_sheet %>
                <p class="small muted">Everything you do in the sheet above is saved every few seconds. When you press <b>Finish &amp; submit</b> (or the time ends) it goes to HR as an Excel file by itself. · शीट अपने-आप सेव होती है और सबमिट होते ही HR को Excel फ़ाइल चली जाती है — कुछ अपलोड नहीं करना।</p>
              <% else %>
                <p class="small muted">Your answers are saved every few seconds. When you press <b>Finish &amp; submit</b> (or the time ends) they go to HR and are marked by themselves. · आपके उत्तर अपने-आप सेव होते हैं और समय खत्म होते ही अपने-आप जमा हो जाते हैं — कुछ अपलोड नहीं करना।</p>
              <% end %>
            </div>
          </div>
        <% else %>
        <h2 style="font-size:1.1rem"><%= icon("upload") %> Upload your finished work<%= " *" if @round.require_upload? %></h2>
        <p class="small muted" style="margin:.3rem 0 1rem">
          Save the file on your computer, then upload it here. You can upload more than once — the last upload is what HR checks.
          Allowed: <%= @round.accept_attribute.split(",").first(10).join(" ") %>. Max <%= Assessment::MAX_FILE_SIZE / 1.megabyte %> MB each.
        </p>
        <div class="dropzone up-zone" data-action="click->assessment#pick dragover->assessment#dragOver dragleave->assessment#dragLeave drop->assessment#dropped">
          <span class="ico"><%= icon("upload") %></span>
          <div class="grow small"><b>Click here or drop your file</b><br><span class="tiny muted">Excel, Word, PDF, ZIP, image — whatever the task asks for</span></div>
          <input type="file" multiple accept="<%= @round.accept_attribute %>" data-assessment-target="fileInput" data-action="change->assessment#chosen">
        </div>
        <p class="upload-status" data-assessment-target="uploadStatus"></p>
        <div class="file-list" data-assessment-target="fileList">
          <% if files.any? %>
            <% files.each do |file| %>
              <div class="file-row">
                <span class="file-ico"><%= icon("file") %></span>
                <div class="grow"><b><%= file.filename %></b><span class="tiny muted"><%= number_to_human_size(file.byte_size) %> · uploaded <%= file.created_at.strftime("%-I:%M %p") %></span></div>
                <button type="button" class="btn btn-light btn-sm" data-action="assessment#remove" data-file-id="<%= file.id %>">Remove</button>
              </div>
            <% end %>
          <% else %>
            <p class="small muted">No file uploaded yet.</p>
          <% end %>
        </div>
        <% end %>

        <%= form_with url: exam_assessment_submit_path(@invitation.token), multipart: true, data: { assessment_target: "form", turbo: false } do %>
          <% if @round.allow_notes? %>
            <div class="field full" style="margin-top:1.2rem">
              <label for="notes"><%= icon("edit") %> <%= auto_saved ? "Notes for HR (optional)" : "Your answer / steps / remarks (optional#{" — or type your answer here instead of a file" unless @round.require_upload?})" %></label>
              <textarea name="notes" id="notes" rows="7" class="input" spellcheck="false" data-assessment-target="notes"
                        data-action="input->assessment#notesChanged"
                        placeholder="e.g. Steps I followed, formulas used, assumptions… (saved automatically)"><%= @round.candidate_notes %></textarea>
              <span class="hint"><span data-assessment-target="noteStatus">Saved automatically</span> · HR can see this</span>
            </div>
          <% end %>
          <div class="row between" style="margin-top:1rem">
            <span class="tiny muted"><%= icon("lock") %> <%= auto_saved ? "Your #{online_sheet ? 'sheet' : 'answers'} and notes save by themselves." : "Your files and notes are saved the moment you upload them." %></span>
            <button type="button" class="btn btn-success" data-action="assessment#confirmSubmit" data-assessment-target="submitButton"><%= icon("check") %> Finish &amp; submit</button>
          </div>
        <% end %>
      </section>
    </div>

    <aside class="exam-side">
      <div class="cam-wrap">
        <div class="cam-preview">
          <video data-proctor-target="video" autoplay muted playsinline></video>
          <span class="cam-tag"><span class="rec-dot"></span> REC</span>
        </div>
        <div class="face-status idle" data-proctor-target="faceStatus"><%= icon("user") %> <span>Starting camera…</span></div>
      </div>
      <div class="card card-pad">
        <b class="small"><%= icon("shield") %> Being checked right now</b>
        <div class="rules tight" style="margin-top:.7rem">
          <div class="rule"><%= icon("user") %> You are alone in front of the camera</div>
          <div class="rule"><%= icon("phone") %> No phone / book on the desk</div>
          <div class="rule"><%= icon("monitor") %> Screen shared &amp; recorded</div>
          <% unless @round.allow_app_switch? %><div class="rule"><%= icon("maximize") %> Full screen, no tab switching</div><% end %>
          <div class="rule"><%= icon("mic") %> No talking / background voices</div>
        </div>
      </div>
      <div class="card card-pad">
        <b class="small"><%= icon("message") %> Need help?</b>
        <p class="tiny muted" style="margin-top:.4rem">Use the video call button at the bottom right to talk to HR, or type in its chat. Asking HR is not a warning.</p>
      </div>
    </aside>
  </div>

  <%# task file viewer: stays on this page, so viewing the task is not a tab switch %>
  <div class="modal-backdrop hidden" data-assessment-target="preview" data-action="click->assessment#closePreviewOutside">
    <div class="modal task-preview">
      <div class="tp-head">
        <b data-assessment-target="previewTitle"></b>
        <button type="button" class="tp-close" data-action="assessment#closePreview" aria-label="Close"><%= icon("x") %></button>
      </div>
      <div class="tp-body" data-assessment-target="previewBody"></div>
    </div>
  </div>

  <div class="modal-backdrop hidden" data-assessment-target="confirm">
    <div class="modal">
      <div class="modal-top"><div class="ring-ico" style="animation:none"><%= icon("send") %></div><h2>Submit your work?</h2><p>You cannot change anything after submitting.</p></div>
      <div class="card-body">
        <% if online_sheet %><p><%= icon("check-circle") %> Your answer sheet is saved and will be submitted.</p><% end %>
        <% if answer_sheet %><p class="as-confirm" id="as-confirm-summary"><%= @round.answered_count %> of <%= @round.answer_items.size %> answered.</p><% end %>
        <% unless auto_saved %>
        <p><b data-assessment-target="confirmFiles"><%= files.size %> file(s) uploaded</b></p>
        <div class="errors hidden" data-assessment-target="confirmNote" style="margin:.8rem 0 0">No file uploaded yet — submit only if your answer is typed in the box.</div>
        <% end %>
        <div class="row" style="margin-top:1.2rem">
          <button type="button" class="btn btn-light grow" data-action="assessment#cancelSubmit">Keep working</button>
          <button type="button" class="btn btn-primary grow" data-action="assessment#submit"><%= icon("check") %> Submit now</button>
        </div>
      </div>
    </div>
  </div>

  <div class="warning-overlay hidden" data-proctor-target="cameraGate" style="z-index:2001">
    <div class="warning-box">
      <div class="big-ico"><%= icon("camera") %></div>
      <h2 data-proctor-target="cameraTitle">Camera required</h2>
      <div class="cam-help gate-guide" data-proctor-target="cameraHelp">Your camera is blocked or disconnected. Allow camera &amp; microphone access in your browser's address bar, then try again. HR has been notified.</div>
      <button type="button" class="btn btn-primary btn-lg btn-block" data-action="proctor#retryCamera"><%= icon("camera") %> Try again</button>
    </div>
  </div>

  <div class="warning-overlay hidden" data-proctor-target="screenGate" style="z-index:2001">
    <div class="warning-box">
      <div class="big-ico" style="background:var(--brand-soft);color:var(--brand)"><%= icon("monitor") %></div>
      <h2 style="color:var(--ink)">Share your entire screen</h2>
      <p>Screen sharing is required during this assessment — HR sees it live and it is recorded. Choose <b>“Entire screen”</b> in the next window.</p>
      <button type="button" class="btn btn-primary btn-lg btn-block" data-action="proctor#shareScreen"><%= icon("monitor") %> Share entire screen</button>
      <p class="tiny" style="color:var(--red);min-height:1em;margin:.6rem 0 0" data-proctor-target="screenError"></p>
    </div>
  </div>

  <div class="warning-overlay hidden" data-proctor-target="fullscreenGate">
    <div class="warning-box">
      <div class="big-ico" style="background:var(--brand-soft);color:var(--brand)"><%= icon("maximize") %></div>
      <h2 style="color:var(--ink)">Return to full screen</h2>
      <p>This assessment must stay in full screen mode. Leaving full screen is reported to HR.</p>
      <button type="button" class="btn btn-primary btn-lg btn-block" data-action="proctor#enterFullscreen"><%= icon("maximize") %> Enter full screen</button>
    </div>
  </div>

  <div class="warning-overlay hidden" data-proctor-target="warning">
    <div class="warning-box">
      <div class="big-ico"><%= icon("alert") %></div>
      <h2>Warning!</h2>
      <p data-proctor-target="warningText">Suspicious activity detected.</p>
      <div class="warning-count" data-proctor-target="warningDots"></div>
      <p class="small" style="margin-top:-.6rem" data-proctor-target="warningLeft"></p>
      <button type="button" class="btn btn-dark btn-lg btn-block" data-action="proctor#dismissWarning">I understand, continue</button>
    </div>
  </div>

  <div class="warning-overlay hidden" data-assessment-target="submitting" style="background:rgba(15,23,42,.6)">
    <div class="warning-box" style="animation:pop .3s">
      <div class="big-ico" style="background:var(--brand-soft);color:var(--brand)"><span class="spinner"></span></div>
      <h2 style="color:var(--ink)" data-assessment-target="submittingTitle">Submitting your work…</h2>
      <p>Uploading your last recording. Please don't close this window.</p>
    </div>
  </div>

  <%# video call with HR: opens by itself when HR joins %>
  <div class="test-call-dock"><%= render "shared/interview_room", invitation: @invitation, test_call: true, token: @invitation.token %></div>
</div>
