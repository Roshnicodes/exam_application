<% content_for :title, "Exam submitted" %>
<% terminated = @invitation.terminated? %>
<%= turbo_stream_from @invitation, :candidate %>
<div class="exam-wrap" data-controller="media-cleanup">
  <%= render "header" %>
  <%= render "exams/interview_cta", invitation: @invitation %>
  <div class="card finish-card">
    <div class="big-ico <%= 'bad' if terminated %>"><%= icon(terminated ? "x-circle" : "check-circle") %></div>
    <% if terminated %>
      <h1>Exam ended</h1>
      <p class="muted" style="margin-top:.6rem">Your exam was closed automatically: <b><%= @invitation.termination_reason %></b>. Your responses so far have been submitted to HR for review.</p>
    <% else %>
      <h1>All done, <%= @invitation.candidate_name.split.first %>! 🎉</h1>
      <p class="muted" style="margin-top:.6rem">Your answers for <b><%= @invitation.vacancy %></b> have been submitted successfully. The HR team will review your assessment and get back to you.</p>
    <% end %>
    <%= render "exams/result", invitation: @invitation %>
    <div class="kv" style="margin-top:2rem;text-align:left">
      <div><span>Answered</span><b><%= @invitation.answered_count %> / <%= @invitation.quiz.questions.size %></b></div>
      <div><span>Submitted at</span><b><%= nice_time(@invitation.submitted_at) %></b></div>
      <% if @invitation.interview_date %><div><span>Interview</span><b><%= @invitation.interview_date.strftime("%d %b %Y, %-I:%M %p") %></b></div><% end %>
      <div><span>Time taken</span><b><%= duration_between(@invitation.started_at, @invitation.submitted_at) %></b></div>
    </div>
    <p class="tiny muted" style="margin-top:2rem"><%= @invitation.interview_open? ? "Your interview has started — use the Join now button above." : "Keep this page open if HR told you an interview follows — a Join button appears here when it starts." %></p>
  </div>
</div>
