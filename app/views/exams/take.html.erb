<% content_for :title, "Exam in progress" %>
<div data-controller="exam proctor"
     data-exam-seconds-left-value="<%= @invitation.seconds_left %>"
     data-exam-answer-url-value="<%= exam_answer_path(@invitation.token) %>"
     data-proctor-events-url-value="<%= exam_events_path(@invitation.token) %>"
     data-proctor-recordings-url-value="<%= exam_recordings_path(@invitation.token) %>"
     data-proctor-warnings-value="<%= @invitation.warnings_count %>"
     data-proctor-max-warnings-value="<%= @invitation.max_warnings %>"
     data-proctor-token-value="<%= @invitation.token %>"
     data-action="proctor:terminated->exam#forceSubmit exam:before-submit->proctor#finish">

  <header class="exam-top">
    <%= render "shared/brand" %>
    <div class="grow hide-sm" style="text-align:center">
      <b><%= @invitation.candidate_name %></b>
      <div class="tiny muted"><%= @invitation.vacancy %> · <span data-exam-target="answeredLabel"><%= @invitation.answered_count %></span>/<%= @questions.size %> answered</div>
    </div>
    <span class="grow" style="display:none"></span>
    <span class="warn-meter" title="Warnings"><%= icon("alert") %> <span data-proctor-target="warnLabel"><%= @invitation.warnings_count %><%= "/#{@invitation.max_warnings}" if @invitation.max_warnings.positive? %></span></span>
    <span class="timer" data-exam-target="timer"><%= icon("clock") %> <span data-exam-target="clock">--:--</span></span>
    <button type="button" class="btn btn-primary btn-sm" data-action="exam#confirmSubmit"><%= icon("send") %><span class="hide-sm">Submit</span></button>
  </header>

  <div class="exam-layout">
    <%= form_with url: exam_submit_path(@invitation.token), id: "exam-form", data: { exam_target: "form", turbo: false } do %>
      <% @questions.each_with_index do |q, i| %>
        <section class="card q-card <%= 'hidden' unless i.zero? %>" data-exam-target="question" data-question-id="<%= q.id %>">
          <div class="q-meta">
            <span class="badge" style="background:var(--brand-soft);color:var(--brand)">Question <%= i + 1 %> of <%= @questions.size %></span>
            <div class="row">
              <span class="pill"><%= pluralize(q.marks, "mark") %></span>
              <button type="button" class="btn btn-ghost btn-sm" data-action="exam#flag"><%= icon("flag") %> Mark for review</button>
            </div>
          </div>
          <div class="q-text"><%= q.body %></div>
          <div class="options">
            <% q.options.each_with_index do |opt, idx| %>
              <label class="option">
                <input type="radio" name="answers[<%= q.id %>]" value="<%= idx %>" <%= "checked" if @invitation.answers[q.id.to_s] == idx %> data-action="change->exam#answer">
                <span class="letter"><%= Question::LETTERS[idx] %></span>
                <span><%= opt %></span>
              </label>
            <% end %>
          </div>
          <div class="q-foot">
            <button type="button" class="btn btn-light" data-action="exam#prev" <%= "disabled" if i.zero? %>><%= icon("chevron-left") %> Previous</button>
            <div class="row">
              <button type="button" class="btn btn-ghost" data-action="exam#clear">Clear</button>
              <% if i == @questions.size - 1 %>
                <button type="button" class="btn btn-success" data-action="exam#confirmSubmit"><%= icon("check") %> Finish exam</button>
              <% else %>
                <button type="button" class="btn btn-primary" data-action="exam#next">Save &amp; next <%= icon("chevron-right") %></button>
              <% end %>
            </div>
          </div>
        </section>
      <% end %>
    <% end %>

    <aside class="exam-side">
      <div class="cam-wrap">
        <div class="cam-preview">
          <video data-proctor-target="video" autoplay muted playsinline></video>
          <span class="cam-tag"><span class="rec-dot"></span> REC</span>
        </div>
        <div class="face-status idle" data-proctor-target="faceStatus"><%= icon("user") %> <span>Starting camera…</span></div>
      </div>
      <div class="card card-pad q-nav-card">
        <div class="row between" style="margin-bottom:.8rem"><b class="small">Questions</b><span class="tiny muted"><%= @questions.size %> total</span></div>
        <div class="q-nav">
          <% @questions.each_with_index do |q, i| %>
            <button type="button" data-exam-target="navButton" data-action="exam#goto" data-index="<%= i %>" class="<%= 'answered' unless @invitation.answers[q.id.to_s].nil? %>"><%= i + 1 %></button>
          <% end %>
        </div>
        <div class="legend"><span><i style="background:var(--green)"></i>Answered</span><span><i style="background:var(--amber)"></i>Review</span><span><i style="background:var(--surface-2);border:1px solid var(--line)"></i>Not visited</span></div>
      </div>
    </aside>
  </div>

  <div class="modal-backdrop hidden" data-exam-target="confirm">
    <div class="modal">
      <div class="modal-top"><div class="ring-ico" style="animation:none"><%= icon("send") %></div><h2>Submit your exam?</h2><p>You won't be able to change answers after submitting.</p></div>
      <div class="card-body">
        <p><b data-exam-target="confirmAnswered">0</b> of <%= @questions.size %> questions answered.</p>
        <div class="row" style="margin-top:1.2rem">
          <button type="button" class="btn btn-light grow" data-action="exam#cancelSubmit">Keep working</button>
          <button type="button" class="btn btn-primary grow" data-action="exam#submit"><%= icon("check") %> Submit now</button>
        </div>
      </div>
    </div>
  </div>

  <div class="warning-overlay hidden" data-proctor-target="cameraGate" style="z-index:2001">
    <div class="warning-box">
      <div class="big-ico"><%= icon("camera") %></div>
      <h2>Camera required</h2>
      <p>Your camera is blocked or disconnected. Allow camera &amp; microphone access in your browser's address bar, then try again. HR has been notified.</p>
      <button type="button" class="btn btn-primary btn-lg btn-block" data-action="proctor#retryCamera"><%= icon("camera") %> Try again</button>
    </div>
  </div>

  <div class="warning-overlay hidden" data-proctor-target="screenGate" style="z-index:2001">
    <div class="warning-box">
      <div class="big-ico" style="background:var(--brand-soft);color:var(--brand)"><%= icon("monitor") %></div>
      <h2 style="color:var(--ink)">Share your entire screen</h2>
      <p>Screen sharing is required during this test (HR sees it live and it is recorded). Choose <b>“Entire screen”</b> in the next window.</p>
      <button type="button" class="btn btn-primary btn-lg btn-block" data-action="proctor#shareScreen"><%= icon("monitor") %> Share entire screen</button>
      <p class="tiny" style="color:var(--red);min-height:1em;margin:.6rem 0 0" data-proctor-target="screenError"></p>
    </div>
  </div>

  <div class="warning-overlay hidden" data-proctor-target="fullscreenGate">
    <div class="warning-box">
      <div class="big-ico" style="background:var(--brand-soft);color:var(--brand)"><%= icon("maximize") %></div>
      <h2 style="color:var(--ink)">Return to full screen</h2>
      <p>The exam must be taken in full screen mode. Leaving full screen is reported to HR.</p>
      <button type="button" class="btn btn-primary btn-lg btn-block" data-action="proctor#enterFullscreen"><%= icon("maximize") %> Enter full screen</button>
    </div>
  </div>

  <div class="warning-overlay hidden" data-proctor-target="warning">
    <div class="warning-box">
      <div class="big-ico"><%= icon("alert") %></div>
      <h2>Warning!</h2>
      <p data-proctor-target="warningText">Suspicious activity detected.</p>
      <div class="warning-count" data-proctor-target="warningDots"></div>
      <p class="small" style="margin-top:-.6rem" data-proctor-target="warningLeft"></p>
      <button type="button" class="btn btn-dark btn-lg btn-block" data-action="proctor#dismissWarning">I understand, continue</button>
    </div>
  </div>

  <div class="warning-overlay hidden" data-exam-target="submitting" style="background:rgba(15,23,42,.6)">
    <div class="warning-box" style="animation:pop .3s">
      <div class="big-ico" style="background:var(--brand-soft);color:var(--brand)"><span class="spinner"></span></div>
      <h2 style="color:var(--ink)" data-exam-target="submittingTitle">Submitting your exam…</h2>
      <p>Uploading your final recording. Please don't close this window.</p>
    </div>
  </div>
</div>
