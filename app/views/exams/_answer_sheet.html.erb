<%# The candidate's answer sheet for a practical test with an answer key, one question at a time:
    the question, and a box under it where the candidate types the answer (nothing to choose).
    The question paper stays open on the left (exams/_question_paper). locals: round:, invitation: %>
<% items = round.answer_items %>
<% choices = items.select { |i| i["kind"] == "choice" } %>
<% others = items.reject { |i| i["kind"] == "choice" } %>
<% ordered = choices + others %>
<% fmt = ->(n) { number_with_precision(n.to_f, precision: 1, strip_insignificant_zeros: true) } %>
<section class="card answer-card" data-controller="answer-sheet"
         data-answer-sheet-url-value="<%= exam_assessment_answers_path(invitation.token) %>"
         data-answer-sheet-total-value="<%= items.size %>"
         data-answer-sheet-key-value="as-step-<%= round.id %>">
  <div class="card-head">
    <h2><%= icon("edit") %> Your answer sheet</h2>
    <span class="row" style="gap:.5rem">
      <span class="state-pill" data-answer-sheet-target="progress"><%= round.answered_count %> / <%= items.size %> answered</span>
      <span class="tiny as-status" data-answer-sheet-target="status">Saves automatically</span>
    </span>
  </div>

  <%# question navigator %>
  <nav class="as-nav" aria-label="Questions">
    <div class="as-nav-group">
      <span class="as-nav-label">Questions</span>
      <% ordered.each_with_index do |item, i| %>
        <button type="button" class="as-nav-btn <%= 'current' if i.zero? %>" data-answer-sheet-target="navButton"
                data-index="<%= i %>" data-id="<%= item['id'] %>" data-action="answer-sheet#go"
                title="<%= item['label'] %>"><%= item["label"].to_s.delete_prefix("Q") %></button>
      <% end %>
    </div>
  </nav>

  <div class="card-body">
    <% ordered.each_with_index do |item, i| %>
      <% answer = round.answers[item["id"]].to_s %>
      <% question = item["question"].presence %>
      <div class="as-step" data-answer-sheet-target="item" data-id="<%= item["id"] %>" data-q="<%= item["id"][/\d+/] %>" <%= "hidden" unless i.zero? %>>
        <div class="as-step-head">
          <span class="as-qno"><%= item["label"] %></span>
          <span class="tiny muted"><%= fmt.(item["marks"]) %> <%= item["marks"].to_f == 1 ? "mark" : "marks" %></span>
          <span class="grow"></span>
          <span class="tiny muted"><%= i + 1 %> of <%= ordered.size %></span>
        </div>

        <% if item["context"].present? %><div class="as-context"><%= simple_format(item["context"]) %></div><% end %>
        <div class="as-qtext">
          <% if question %>
            <%= simple_format(question) %>
          <% else %>
            <p><b><%= item["title"].presence || item["label"] %></b></p>
            <p class="tiny muted">Read the full question <b><%= item["label"] %></b> in the question paper. · पूरा प्रश्न प्रश्नपत्र में देखें।</p>
          <% end %>
        </div>

        <% if item["kind"] == "choice" %>
          <% if Array(item["options"]).any? %>
            <ol class="as-optlist" type="a"><% item["options"].each do |option| %><li><%= option %></li><% end %></ol>
          <% end %>
          <label class="as-label" for="as_<%= item["id"] %>">Your answer</label>
          <input type="text" id="as_<%= item["id"] %>" class="input" placeholder="Type your answer (e.g. b, or the answer itself)" spellcheck="false"
                 autocomplete="off" value="<%= answer %>" data-answer="<%= item["id"] %>" data-action="input->answer-sheet#changed keydown.enter->answer-sheet#next:prevent">
        <% elsif item["kind"] == "number" %>
          <label class="as-label" for="as_<%= item["id"] %>">Your answer</label>
          <input type="text" inputmode="decimal" id="as_<%= item["id"] %>" class="input" placeholder="Your answer (number / amount)" spellcheck="false"
                 value="<%= answer %>" data-answer="<%= item["id"] %>" data-action="input->answer-sheet#changed keydown.enter->answer-sheet#next:prevent">
        <% else %>
          <label class="as-label" for="as_<%= item["id"] %>">Your answer</label>
          <textarea id="as_<%= item["id"] %>" rows="8" class="input" spellcheck="false"
                    placeholder="Write your answer — show the working and the final figures (amounts, sections, due dates…)"
                    data-answer="<%= item["id"] %>" data-action="input->answer-sheet#changed"><%= answer %></textarea>
        <% end %>
      </div>
    <% end %>

    <div class="as-foot">
      <button type="button" class="btn btn-light" data-answer-sheet-target="prev" data-action="answer-sheet#prev" disabled><%= icon("chevron-left") %> Previous</button>
      <span class="grow"></span>
      <button type="button" class="btn btn-primary" data-answer-sheet-target="next" data-action="answer-sheet#next">Next <%= icon("chevron-right") %></button>
      <button type="button" class="btn btn-success" data-answer-sheet-target="finish" data-action="assessment#confirmSubmit" hidden><%= icon("check") %> Review &amp; submit</button>
    </div>
  </div>
</section>
