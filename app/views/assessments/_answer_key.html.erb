<%# The questions read from the answer key; HR checks / corrects them here. locals: assessment: %>
<div class="card" id="answer-key">
  <div class="card-head">
    <h2><%= icon("check-circle") %> Answer key</h2>
    <% if assessment.answer_sheet? %>
      <span class="row" style="gap:.4rem">
        <span class="state-pill green"><%= pluralize(assessment.answer_items.size, "question") %> · <%= number_with_precision(assessment.key_total, precision: 1, strip_insignificant_zeros: true) %> marks</span>
        <%= button_to remove_answer_key_assessment_path(assessment), method: :delete, class: "btn btn-light btn-sm",
              form: { data: { turbo_confirm: "Remove the answer key? Answers will then be marked by hand." } } do %><%= icon("trash") %> Remove<% end %>
      </span>
    <% end %>
  </div>
  <% if assessment.answer_sheet? %>
    <div class="card-body">
      <% if assessment.answer_items.any? { |i| i["from_paper"] } && !assessment.answer_key.attached? %>
        <p class="task-note" style="margin:0 0 .8rem"><%= icon("alert") %> <span>This answer sheet was made from the question paper.
          <% if assessment.answer_items.any? { |i| i["kind"] == "choice" && i["answer"].blank? } %>Fill the correct option of each MCQ below (or upload an answer key) so they are marked by themselves — until then HR marks them.<% else %>Answers found in the paper were used as the key — check them below.<% end %></span></p>
      <% end %>
      <p class="small muted" style="margin-bottom:.8rem">The candidate answers these questions on an answer sheet; it is marked when they submit. Correct anything that was read wrongly and press <b>Save answer key</b>.
        <b>Option</b> and <b>Number</b> answers are marked exactly (numbers allow ±1%); <b>Written</b> answers get marks for the key points of the model answer — HR can change any mark later.</p>
      <%= form_with url: answer_key_assessment_path(assessment), method: :patch do %>
        <div class="table-wrap">
          <table class="table key-table">
            <thead><tr><th>Q</th><th>Question / part</th><th>Type</th><th>Correct answer / key points</th><th class="num">Marks</th><th></th></tr></thead>
            <tbody>
              <% assessment.answer_items.each_with_index do |item, i| %>
                <tr>
                  <td><b><%= item["label"] %></b><%= hidden_field_tag "items[#{i}][id]", item["id"] %></td>
                  <td class="small"><%= item["title"].presence || (item["kind"] == "choice" ? "Multiple choice" : "—") %></td>
                  <td><%= select_tag "items[#{i}][kind]", options_for_select(AnswerKey::KINDS.invert, item["kind"]), class: "input input-sm" %></td>
                  <td>
                    <% if item["kind"] == "text" %>
                      <div class="key-terms">
                        <% if item["terms"].present? %>
                          <% item["terms"].each do |t| %><span class="chip"><%= AnswerKey.term_label(t) %></span><% end %>
                        <% else %>
                          <span class="tiny muted">No key points found — marked by HR</span>
                        <% end %>
                      </div>
                      <details class="key-model"><summary class="tiny">Model answer</summary>
                        <%= text_area_tag "items[#{i}][model]", item["model"], rows: 5, class: "input" %>
                        <span class="hint">Key points (amounts, %, dates, sections, forms) are taken from this text when you save.</span>
                      </details>
                    <% else %>
                      <%= text_field_tag "items[#{i}][answer]", item["answer"], class: "input input-sm", style: "max-width:9rem",
                            placeholder: item["kind"] == "choice" ? "A / B / C / D" : "e.g. 30700" %>
                      <% if item["model"].present? %><div class="tiny muted" style="margin-top:.25rem"><%= truncate(item["model"], length: 140) %></div><% end %>
                    <% end %>
                  </td>
                  <td class="num"><%= number_field_tag "items[#{i}][marks]", number_with_precision(item["marks"], precision: 2, strip_insignificant_zeros: true), step: 0.5, min: 0, class: "input input-sm", style: "width:5rem" %></td>
                  <td><label class="chip-del" title="Leave this question out"><%= check_box_tag "items[#{i}][remove]", "1", false %> <span><%= icon("trash") %></span></label></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="row between" style="margin-top:1rem;flex-wrap:wrap;gap:.6rem">
          <span class="tiny muted">The test is marked out of the key's total (<%= number_with_precision(assessment.key_total, precision: 1, strip_insignificant_zeros: true) %>) — pass mark <%= assessment.pass_percentage %>%.</span>
          <button type="submit" class="btn btn-primary"><%= icon("check") %> Save answer key</button>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card-body small muted">No answer key — answers are marked by hand. <%= link_to "Upload an answer key", edit_assessment_path(assessment) %> to mark the candidate's answer sheet automatically (MCQs, numbers and written answers).</div>
  <% end %>
</div>
