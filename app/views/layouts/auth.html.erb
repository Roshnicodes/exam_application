<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "shared/head" %>
  </head>
  <body class="auth-body">
    <main class="auth">
      <div class="auth-shell">
        <section class="auth-art">
          <%= render "shared/brand" %>
          <div class="auth-copy">
            <h1 class="chayan"><b>C</b>andidate <b>H</b>iring, <b>A</b>ssessment, <b>Y</b>early onboarding, <b>A</b>nd <b>N</b>urturing</h1>
            <p>An Integrated Talent Acquisition &amp; Employee Development Platform</p>
          </div>
          <ul class="auth-points">
            <li><span><%= icon("key") %></span> OTP verified by HR</li>
            <li><span><%= icon("camera") %></span> Face &amp; activity monitoring</li>
            <li><span><%= icon("bell") %></span> Instant ring alerts</li>
          </ul>
        </section>
        <section class="auth-form">
          <div class="auth-card"><%= yield %></div>
        </section>
      </div>
      <p class="auth-foot">© <%= Date.current.year %> ASA CHAYAN · An Integrated Talent Acquisition &amp; Employee Development Platform</p>
    </main>
    <%= render "shared/flash" %>
  </body>
</html>
