<% content_for :title, "Dashboard" %>
<%= turbo_stream_from Current.user, :invitations %>
<% hour = Time.current.hour %>

<div class="dash">
  <div class="dash-main">
    <section class="dash-hero">
      <div class="dh-copy">
        <h1><%= hour < 12 ? "Good Morning" : (hour < 17 ? "Good Afternoon" : "Good Evening") %>, <%= Current.user.first_name %> 👋</h1>
        <p>Manage your interviews, track candidates and ensure a smooth &amp; fair hiring process.</p>
        <div class="dh-chips">
          <span class="dh-chip"><span class="dh-dot"></span> System Online</span>
          <span class="dh-chip"><%= icon("calendar") %> Today, <%= Date.current.strftime("%d %b %Y") %></span>
        </div>
      </div>
      <%= render "dashboard/hero_art" %>
      <span class="dh-script">Right People<br>Build<br>Great Teams</span>
    </section>

    <div class="trend-cards">
      <% @cards.each do |c| %>
        <%= link_to c[:path], class: "trend-card tone-#{c[:tone]}" do %>
          <div class="tc-head"><span class="tc-ico"><%= icon(c[:icon]) %></span><small><%= c[:label] %></small></div>
          <div class="tc-foot">
            <div>
              <div class="tc-row">
                <b><%= c[:value].to_s.rjust(2, "0") %></b>
                <% if c[:change].nonzero? %>
                  <span class="tc-change <%= c[:change].positive? ? 'up' : 'down' %>"><%= icon(c[:change].positive? ? "arrow-up" : "arrow-down") %><%= c[:change].abs %>%</span>
                <% end %>
              </div>
              <em><%= c[:note] %></em>
            </div>
            <%= sparkline(c[:spark]) %>
          </div>
        <% end %>
      <% end %>
    </div>

    <section class="card">
      <div class="card-head">
        <h2><%= icon("calendar") %> <%= @schedule_title %></h2>
        <%= link_to schedule_path, class: "view-all" do %>View all <%= icon("arrow-right") %><% end %>
      </div>
      <% if @schedule.any? %>
        <div class="sched-strip">
          <% @schedule.each_with_index do |r, i| %>
            <%= link_to invitation_path(r.invitation, anchor: "rounds"), class: "sched-card tone-#{%w[green blue violet blue teal][i]} #{'is-live' if r.open?}" do %>
              <div class="row between"><b class="sc-time"><%= r.open? ? "Live now" : r.scheduled_at&.strftime(r.scheduled_at.today? ? "%I:%M %p" : "%d %b, %I:%M %p") %></b><% if r.open? %><span class="dh-dot"></span><% end %></div>
              <b class="sc-name"><%= r.invitation.candidate_name %></b>
              <small><%= r.invitation.vacancy %> · <%= r.name %></small>
              <div class="row sc-foot">
                <span class="avatar xs" style="background: <%= gradient_for(r.invitation.candidate_name) %>"><%= initials_for(r.invitation.candidate_name) %></span>
                <span class="state-pill <%= r.open? ? 'green' : 'blue' %>"><%= r.open? ? "In Progress" : "Upcoming" %></span>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="card-body muted small">No interviews scheduled. Set a date on a candidate's interview round and it shows up here.</div>
      <% end %>
    </section>

    <section class="card">
      <div class="card-head">
        <h2><%= icon("users") %> Recent Candidates</h2>
        <%= link_to invitations_path, class: "view-all" do %>View all <%= icon("arrow-right") %><% end %>
      </div>
      <% if @recent.any? %>
        <div class="table-wrap">
          <table class="table dash-table">
            <thead><tr><th>Name</th><th>Position</th><th>Invited for</th><th class="hide-sm">Invited on</th><th>Status</th><th class="hide-sm">Action</th></tr></thead>
            <tbody>
              <% @recent.each do |inv| %>
                <tr>
                  <td><%= link_to invitation_path(inv), class: "person" do %><span class="avatar xs" style="background: <%= gradient_for(inv.candidate_name) %>"><%= initials_for(inv.candidate_name) %></span><b><%= inv.candidate_name %></b><% end %></td>
                  <td class="muted"><%= inv.vacancy %></td>
                  <td><span class="state-pill <%= inv.test_only? ? 'blue' : 'violet' %>"><%= icon(inv.test_only? ? "file" : "video") %> <%= inv.invited_for %></span></td>
                  <td class="muted hide-sm"><%= inv.created_at.strftime("%d %b %Y, %I:%M %p") %></td>
                  <td><%= status_badge(inv) %></td>
                  <td class="hide-sm"><%= link_to invitation_path(inv), class: "view-all" do %>View <%= icon("arrow-right") %><% end %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="empty">
          <div class="ico"><%= icon("send") %></div>
          <h3>No candidates yet</h3>
          <p>Invite your first candidate to an online exam.</p><br>
          <%= link_to new_invitation_path, class: "btn btn-primary" do %><%= icon("plus") %> Invite candidate<% end %>
        </div>
      <% end %>
    </section>
  </div>

  <aside class="dash-side">
    <div class="quick-actions">
      <%= link_to new_vacancy_path, class: "qa qa-violet" do %><span><%= icon("plus") %></span><div><b>New Job / Vacancy</b><small>Create a new position</small></div><%= icon("arrow-right") %><% end %>
      <%= link_to new_invitation_path(plan: "none"), class: "qa qa-blue" do %><span><%= icon("file") %></span><div><b>Start Test</b><small>Send an online test link</small></div><%= icon("arrow-right") %><% end %>
      <%= link_to new_invitation_path, class: "qa qa-green" do %><span><%= icon("mail") %></span><div><b>Invite Candidate</b><small>Test + interview, via WhatsApp / Email</small></div><%= icon("arrow-right") %><% end %>
      <%= link_to live_monitor_path, class: "qa qa-orange" do %><span><%= icon("video") %></span><div><b>Start Interview</b><small>Monitor &amp; evaluate</small></div><%= icon("arrow-right") %><% end %>
    </div>

    <section class="card live-card">
      <div class="card-head">
        <h2><span class="dh-dot"></span> Live Interview Activity</h2>
        <span class="state-pill <%= @live ? 'green' : '' %>"><%= @live ? "Live" : "Idle" %></span>
      </div>
      <div class="card-body">
        <% if @live %>
          <div class="live-now">
            <%= render "shared/live_video", invitation: @live, compact: true %>
            <div>
              <b><%= @live.candidate_name %></b>
              <small><%= @live.vacancy %></small>
              <span class="state-pill green">• In Progress</span>
              <%= link_to "Watch", invitation_path(@live), class: "btn btn-light btn-sm" %>
            </div>
          </div>
        <% else %>
          <div class="live-idle"><%= icon("video") %><span>No candidate is live right now. Live exams and interviews appear here.</span></div>
        <% end %>
        <ul class="timeline live-feed" id="dashboard-feed">
          <% if @feed.any? %>
            <%= render partial: "proctor_events/proctor_event", collection: @feed, locals: { show_candidate: true } %>
          <% else %>
            <li class="muted small" id="feed-empty">Activity from candidates will stream here.</li>
          <% end %>
        </ul>
        <%= link_to live_monitor_path, class: "rt-box" do %>
          <%= icon("activity") %>
          <div><b>Monitoring in real-time</b><small><%= @alerts_today.zero? ? "Proctoring for fair & secure exams" : "#{pluralize(@alerts_today, 'warning')} today" %></small></div>
          <span class="rt-shield"><%= icon("shield") %></span>
        <% end %>
      </div>
    </section>

    <section class="sunset-card" aria-hidden="true">
      <svg viewBox="0 0 300 150" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="ss-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#8ec5e8"/><stop offset=".55" stop-color="#fde2b0"/><stop offset="1" stop-color="#fbbf77"/></linearGradient>
          <radialGradient id="ss-sun" cx=".7" cy=".62" r=".35"><stop offset="0" stop-color="#fff7d6"/><stop offset=".25" stop-color="#ffe29a" stop-opacity=".9"/><stop offset="1" stop-color="#ffe29a" stop-opacity="0"/></radialGradient>
        </defs>
        <rect width="300" height="150" fill="url(#ss-sky)"/>
        <rect width="300" height="150" fill="url(#ss-sun)"/>
        <path d="M0 100 60 70l40 18 50-34 46 30 40-20 64 30v56H0z" fill="#6b8f9e" opacity=".55"/>
        <path d="M0 116 50 96l46 14 58-26 52 24 40-12 54 20v34H0z" fill="#3f6b5a" opacity=".8"/>
        <path d="M0 132c60-14 120-18 180-10s90 8 120 2v26H0z" fill="#24493b"/>
      </svg>
      <span>Great Interviews<br>Build<br>Great Careers</span>
    </section>
  </aside>
</div>
