<%# Meet-style room for one round. locals: round:, token: (candidate), watch_token: (panelist), name: (HR),
    panelists: (panelist picks their name), leave_url:, side: (HTML for the right panel)
    Video call during the online test: invitation: instead of round:, plus test_call: true %>
<% panelists = local_assigns[:panelists] %>
<% test_call = local_assigns[:test_call] %>
<% round = local_assigns[:round] %>
<% title = test_call ? "video call" : round.name %>
<div class="it-room <%= 'test-call' if test_call %>" data-controller="interview-room"
     <% if round %>data-interview-room-round-id-value="<%= round.id %>"<% end %>
     <% if test_call %>data-interview-room-test-value="true" data-interview-room-invitation-id-value="<%= invitation.id %>"<% end %>
     <% if local_assigns[:auto_join] %>data-interview-room-auto-join-value="true"<% end %>
     <% if local_assigns[:talk] %>data-interview-room-talk-value="true"<% end %>
     data-interview-room-leave-url-value="<%= local_assigns[:leave_url] %>"
     <% if local_assigns[:token] %>data-interview-room-token-value="<%= token %>"<% end %>
     <% if local_assigns[:watch_token] %>data-interview-room-watch-token-value="<%= watch_token %>"<% end %>
     <% if local_assigns[:name] %>data-interview-room-name-value="<%= name %>"<% end %>
     <% if local_assigns[:tile] %>data-interview-room-audio-only-value="true"<% end %>
     data-interview-room-needs-name-value="<%= panelists ? 'true' : 'false' %>">
  <% if local_assigns[:tile] %>
    <%# Live monitor tile: Meet-style mic — unmute to talk to this candidate, mute to stop %>
    <button type="button" class="mon-mic off" data-interview-room-target="tileMic" data-action="interview-room#tileToggle"
            title="Unmute to talk to <%= invitation.candidate_name %>" aria-label="Unmute to talk"><%= icon("mic") %></button>
    <div class="tile-call" hidden>
  <% end %>

  <% if panelists || (test_call && !local_assigns[:token]) %>
    <form class="card it-join" data-interview-room-target="joinPanel" data-action="submit->interview-room#joinAs">
      <div class="it-join-ico"><%= icon("video") %></div>
      <h2>Join <%= title %></h2>
      <p class="muted small"><%= test_call ? "Talk face to face with the candidate during the test — like Google Meet. Everyone who joins sees and hears each other." : "Pick your name so the candidate and others know who is speaking." %></p>
      <% if panelists %>
        <select class="input" data-interview-room-target="nameInput" required>
          <option value="">— I am —</option>
          <% panelists.each do |p| %><option value="<%= p.name %>"><%= p.name %><%= " (#{p.designation})" if p.designation.present? %></option><% end %>
          <option value="Guest panelist">Someone else (guest panelist)</option>
        </select>
      <% end %>
      <button class="btn btn-primary btn-lg btn-block"><%= icon("video") %> Join with camera &amp; mic</button>
    </form>
  <% end %>

  <% if local_assigns[:token] && !test_call %>
    <div class="card it-join it-screen-gate hidden" data-interview-room-target="screenGate">
      <div class="it-join-ico"><%= icon("monitor") %></div>
      <h2>Share your entire screen</h2>
      <p class="muted small">For a fair interview the panel sees your screen during <b><%= title %></b>. Choose <b>“Entire screen”</b> in the next window. The interview runs in full screen; switching tabs, other apps, phones or other people are flagged to the panel.</p>
      <button type="button" class="btn btn-primary btn-lg btn-block" data-action="interview-room#shareScreen"><%= icon("monitor") %> Share screen &amp; join</button>
      <p class="tiny" style="color:var(--red);min-height:1em" data-interview-room-target="screenError"></p>
    </div>
  <% end %>

  <div class="it-layout <%= 'no-side' unless local_assigns[:side] %> hidden" data-interview-room-target="room">
    <div class="it-stage">
      <% if test_call && local_assigns[:token] %>
        <div class="tc-head"><span class="rec-dot"></span> <b>Video call with HR</b><button type="button" class="tc-min" data-action="interview-room#minimize" title="Minimise">—</button></div>
      <% end %>
      <div class="it-alerts" data-interview-room-target="alerts"></div>
      <div class="it-switch-note hidden" data-interview-room-target="switchNote"></div>
      <div class="it-grid" data-interview-room-target="grid" data-count="1">
        <div class="it-tile it-self connected">
          <video data-interview-room-target="localVideo" autoplay muted playsinline></video>
          <div class="it-placeholder"><span class="avatar">You</span></div>
          <span class="it-name">You</span>
        </div>
      </div>
      <p class="it-status" data-interview-room-target="status">Joining…</p>
      <button type="button" class="it-tap hidden" data-interview-room-target="tap" data-action="interview-room#playAll">🔊 Tap to hear the call</button>
      <div class="it-controls">
        <% unless test_call && local_assigns[:token] %><%# the candidate's camera & mic stay on for proctoring %>
          <button type="button" class="it-btn" data-interview-room-target="micBtn" data-action="interview-room#toggleMic"><%= icon("mic") %><span>Mute</span></button>
          <button type="button" class="it-btn" data-interview-room-target="camBtn" data-action="interview-room#toggleCam"><%= icon("video") %><span>Stop video</span></button>
        <% end %>
        <% unless local_assigns[:token] %>
          <button type="button" class="it-btn" data-interview-room-target="presentBtn" data-action="interview-room#togglePresent" title="Share your screen with everyone"><%= icon("monitor") %><span>Present</span></button>
        <% end %>
        <% unless test_call %>
          <button type="button" class="it-btn" data-interview-room-target="codeBtn" data-action="interview-room#toggleCode" title="Shared code editor"><%= icon("code") %><span>Code</span></button>
        <% end %>
        <% unless test_call || local_assigns[:token] %>
          <button type="button" class="it-btn" data-interview-room-target="switchBtn" data-action="interview-room#toggleSwitch" title="Let the candidate open another app or website (e.g. an online editor) without warnings"><%= icon("unlock") %><span>Allow switching apps</span></button>
        <% end %>
        <button type="button" class="it-btn it-chat-btn" data-interview-room-target="chatBtn" data-action="interview-room#toggleChat"><%= icon("message") %><span>Chat</span><b class="it-unread hidden" data-interview-room-target="unread">0</b></button>
        <span class="it-count" data-interview-room-target="count">1 in the room</span>
        <% if round&.meeting_link.present? %>
          <a class="it-btn" href="<%= round.meeting_link %>" target="_blank" rel="noopener" title="Open the external meeting link"><%= icon("link") %><span>Meet / Zoom</span></a>
        <% end %>
        <% unless test_call && local_assigns[:token] %>
          <button type="button" class="it-btn leave" data-action="interview-room#leave"><%= icon("x") %><span><%= test_call ? "Leave call" : "Leave" %></span></button>
        <% end %>
      </div>
      <% unless test_call %>
        <section class="it-code hidden" data-interview-room-target="code">
          <header>
            <b><%= icon("code") %> Code pad</b>
            <select class="it-code-lang" data-interview-room-target="codeLang" data-action="change->interview-room#codeChanged" aria-label="Language">
              <% CodePad::LANGUAGES.each do |key, label| %><option value="<%= key %>"><%= label %></option><% end %>
            </select>
            <span class="it-code-by" data-interview-room-target="codeBy"><%= local_assigns[:token] ? "Write your code here — the panel sees it live" : "Everyone sees and can edit this live" %></span>
            <button type="button" class="it-chat-x" data-action="interview-room#toggleCode" aria-label="Close code pad">×</button>
          </header>
          <textarea class="it-code-input" spellcheck="false" autocomplete="off" autocapitalize="off" placeholder="// write your code here" data-interview-room-target="codeInput"
                    data-action="input->interview-room#codeChanged keydown->interview-room#codeKey"></textarea>
        </section>
      <% end %>
      <section class="it-chat hidden" data-interview-room-target="chat">
        <header><b><%= icon("message") %> <%= local_assigns[:token] ? "Chat with the panel" : "Chat with everyone" %></b><button type="button" class="it-chat-x" data-action="interview-room#toggleChat" aria-label="Close chat">×</button></header>
        <ol class="it-msgs" data-interview-room-target="messages">
          <li class="it-msg-empty"><%= local_assigns[:token] ? "Questions from the panel appear here. Type your answer below." : "Type a question — the candidate sees it instantly and can answer here." %></li>
        </ol>
        <form class="it-chat-form" data-action="submit->interview-room#sendChat">
          <textarea rows="1" maxlength="2000" placeholder="<%= local_assigns[:token] ? 'Type your answer…' : 'Type a question or message…' %>" data-interview-room-target="chatInput" data-action="keydown->interview-room#chatKey"></textarea>
          <button class="it-send" aria-label="Send"><%= icon("send") %></button>
        </form>
      </section>
    </div>
    <% if local_assigns[:side] %><aside class="it-side"><%= side %></aside><% end %>
    <%= local_assigns[:extra] %>
  </div>
  <% if local_assigns[:tile] %></div><% end %>
</div>
