<%# Interview panel with share buttons for the read-only watch link.
    locals: panelists:, watch_link:, edit_path:, invitation: nil, batch: nil %>
<div class="card" data-controller="clipboard">
  <div class="card-head">
    <h2><%= icon("users") %> Interview panel</h2>
    <span class="row" style="gap:.35rem">
      <input type="hidden" value="<%= watch_link %>" data-clipboard-target="source">
      <button type="button" class="btn btn-light btn-sm" data-action="clipboard#copy" title="<%= watch_link %>"><%= icon("eye") %> <span data-clipboard-target="label">Copy watch link</span></button>
      <%= link_to edit_path, class: "act-btn", title: "Change panel" do %><%= icon("edit") %><% end %>
    </span>
  </div>
  <% if panelists.any? %>
    <% panelists.each do |p| %>
      <% text = panelist_share_text(p, invitation: local_assigns[:invitation], batch: local_assigns[:batch]) %>
      <div class="list-item">
        <span class="avatar" style="background: <%= gradient_for(p.name) %>"><%= initials_for(p.name) %></span>
        <div class="grow person"><div><b><%= p.name %></b><span><%= p.subtitle.presence || p.email %></span></div></div>
        <span class="row-actions">
          <%= whatsapp_button(p.phone, text, label: nil, css: "act-btn wa", title: "Send watch link on WhatsApp") %>
          <% if p.email.present? %>
            <a class="act-btn" title="Email watch link to <%= p.email %>" href="mailto:<%= p.email %>?subject=<%= ERB::Util.url_encode("Interview panel – live view") %>&body=<%= ERB::Util.url_encode(text) %>"><%= icon("mail") %></a>
          <% end %>
        </span>
      </div>
    <% end %>
  <% else %>
    <div class="card-body small muted">No panelists yet. <%= link_to "Add panelists", edit_path %> — they get a private link to watch the live camera.</div>
  <% end %>
</div>
