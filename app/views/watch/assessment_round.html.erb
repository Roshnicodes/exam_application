<% content_for :title, "#{@round.name} · #{@invitation.candidate_name}" %>
<%= turbo_stream_from @invitation, :events %>
<%= render layout: "shared/page_header", locals: {
      title: "#{@round.name} — #{@invitation.candidate_name}", icon: @round.task_icon,
      subtitle: @round.working? ? "Practical assessment — working now (#{@round.seconds_left / 60} min left)" : "Practical assessment #{@round.status_label.downcase}",
      chips: [ [ "clock", "#{@round.duration} minutes" ], [ "award", "#{@round.total_marks} marks" ],
               ([ "calendar", @round.scheduled_at.strftime("%a %d %b, %-I:%M %p") ] if @round.scheduled_at) ].compact } do %>
  <%= link_to "Back to candidate", watch_path(params[:watch_token]), class: "btn btn-light" %>
<% end %>

<div class="split">
  <div class="stack">
    <% if @round.working? || @round.open? %>
      <div class="card">
        <div class="card-head"><h2><%= icon("monitor") %> Live camera &amp; screen</h2><span class="pill"><span class="live-dot"></span> Live</span></div>
        <div class="card-body"><%= render "shared/live_video", invitation: @invitation, watch_token: params[:watch_token] %></div>
      </div>
      <div class="card">
        <div class="card-head"><h2><%= icon("users") %> Talk to the candidate</h2></div>
        <div class="card-body"><%= render "shared/interview_room", invitation: @invitation, test_call: true, watch_token: params[:watch_token],
                  panelists: @panelists, allow_switch: true %></div>
      </div>
    <% end %>
    <%= render "interview_rounds/submission", round: @round, invitation: @invitation, readonly: true %>
    <div class="card">
      <div class="card-head"><h2><%= icon(@round.task_icon) %> The task</h2></div>
      <div class="card-body stack">
        <% if @round.task_attachments.any? %>
          <div class="file-list">
            <% @round.task_attachments.each do |file| %>
              <div class="file-row">
                <span class="file-ico"><%= icon("file") %></span>
                <div class="grow"><b><%= file.filename %></b><span class="tiny muted"><%= number_to_human_size(file.byte_size) %></span></div>
                <%= link_to rails_blob_path(file, disposition: "attachment"), class: "btn btn-light btn-sm", data: { turbo: false } do %><%= icon("download") %> Download<% end %>
              </div>
            <% end %>
          </div>
        <% end %>
        <% if @round.task_instructions.present? %><div class="task-text"><%= simple_format(@round.task_instructions) %></div><% end %>
      </div>
    </div>
    <div class="card">
      <div class="card-head"><h2><%= icon("bell") %> What happened during this assessment</h2><span class="pill"><span class="live-dot"></span> Live</span></div>
      <ul class="timeline scroll-y" id="events_invitation_<%= @invitation.id %>">
        <%= render partial: "proctor_events/proctor_event", collection: @events %>
      </ul>
    </div>
  </div>
  <div class="stack">
    <%= render "interview_feedbacks/form", round: @round, feedback: InterviewFeedback.new, url: watch_feedback_path(params[:watch_token], @round), panelists: @panelists %>
    <%= render "interview_feedbacks/candidate_brief", invitation: @invitation %>
    <%= render "invitations/selection_card", invitation: @invitation %>
  </div>
</div>
