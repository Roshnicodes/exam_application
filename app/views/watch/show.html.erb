<% content_for :title, "Live · #{@invitation.candidate_name}" %>
<%= turbo_stream_from @invitation, :events %>
<%= render layout: "shared/page_header", locals: {
      title: @invitation.candidate_name, avatar: initials_for(@invitation.candidate_name),
      subtitle: [ @invitation.vacancy, @invitation.department.presence, @invitation.quiz.title ].compact.join(" · "),
      chips: [ [ "clock", "#{@invitation.quiz.duration_minutes} min" ], [ "list", "#{@invitation.quiz.questions.size} questions" ] ] } do %>
  <% if @invitation.meeting_link.present? %><a class="btn btn-light" href="<%= @invitation.meeting_link %>" target="_blank" rel="noopener"><%= icon("link") %> Meet / Zoom</a><% end %>
  <% if (live = @invitation.current_round) %>
    <%= link_to watch_round_path(params[:watch_token], live), class: "btn btn-primary" do %><%= icon("video") %> Join <%= live.name %> (live)<% end %>
  <% end %>
<% end %>

<div class="split">
  <div class="stack">
    <div class="card">
      <div class="card-head"><h2><%= icon("video") %> Live camera</h2></div>
      <div class="card-body"><%= render "shared/live_video", invitation: @invitation, watch_token: params[:watch_token] %></div>
    </div>
    <% unless @invitation.finished? %>
      <div class="card" id="test-call">
        <div class="card-head"><h2><%= icon("users") %> Video call during the test</h2></div>
        <div class="card-body"><%= render "shared/interview_room", invitation: @invitation, test_call: true, watch_token: params[:watch_token], panelists: @invitation.panelists %></div>
      </div>
    <% end %>
    <div class="card">
      <div class="card-head"><h2><%= icon("bell") %> Proctoring timeline</h2><span class="pill"><span class="live-dot"></span> Live</span></div>
      <ul class="timeline scroll-y" id="events_invitation_<%= @invitation.id %>">
        <%= render partial: "proctor_events/proctor_event", collection: @events %>
      </ul>
    </div>
  </div>
  <div class="stack">
    <%= render "watch/review_card", invitation: @invitation, watch_token: params[:watch_token] %>
    <%= render "invitations/live_state", invitation: @invitation %>
    <%= render "interview_rounds/watch_list", invitation: @invitation, watch_token: params[:watch_token] %>
    <% if @invitation.resume.attached? %>
      <%= link_to rails_blob_path(@invitation.resume, disposition: "inline"), class: "btn btn-light btn-block", target: "_blank" do %><%= icon("file") %> View resume<% end %>
    <% end %>
    <%= render "invitations/selection_card", invitation: @invitation %>
    <%= render "interview_feedbacks/summary", invitation: @invitation %>
  </div>
</div>
