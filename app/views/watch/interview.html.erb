<% content_for :title, "Interview · #{@invitation.candidate_name}" %>
<%= turbo_stream_from @invitation, :events %>
<%= render layout: "shared/page_header", locals: {
      title: "Interview — #{@invitation.candidate_name}", icon: "video",
      subtitle: @invitation.interview_open? ? "You can see and talk to the candidate and the other panelists." : "HR hasn't opened the room yet — you can join and wait; the candidate appears once it opens." } do %>
  <%= link_to "Back to live view", watch_path(params[:watch_token]), class: "btn btn-light" %>
<% end %>

<% side = capture do %>
  <%= render "interview_feedbacks/candidate_brief", invitation: @invitation %>
  <% if @panelists.any? %>
    <%= render "interview_feedbacks/form", invitation: @invitation, feedback: InterviewFeedback.new, url: watch_feedback_path(params[:watch_token]), panelists: @panelists %>
  <% end %>
  <%= render "interview_feedbacks/summary", invitation: @invitation %>
<% end %>

<%= render "shared/interview_room", invitation: @invitation, watch_token: params[:watch_token], panelists: @panelists,
      leave_url: watch_path(params[:watch_token]), side: side %>
