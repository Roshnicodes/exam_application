<% content_for :title, "Candidate guide" %>
<% content_for :head do %><link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;600;700&display=swap" rel="stylesheet"><% end %>
<%# Shared with candidates before the online test (link + PDF). English with Hindi below each point. %>
<% warnings = [
     [ "monitor", "Switching to another tab, window or app, or minimising the test", "दूसरा टैब, विंडो या ऐप खोलना, या टेस्ट को छोटा (minimise) करना" ],
     [ "phone", "On a phone: opening another app, the home screen, the notification panel or split screen, or locking the phone", "फ़ोन पर: कोई दूसरा ऐप, होम स्क्रीन, नोटिफ़िकेशन पैनल या स्प्लिट स्क्रीन खोलना, या फ़ोन लॉक करना" ],
     [ "eye", "Clicking outside the test window", "टेस्ट विंडो के बाहर क्लिक करना" ],
     [ "maximize", "Leaving full screen (pressing Esc)", "फुल स्क्रीन से बाहर आना (Esc दबाना)" ],
     [ "user", "Your face is not visible — leaving the seat or covering the camera", "चेहरा कैमरे में न दिखना — सीट छोड़ना या कैमरा ढकना" ],
     [ "users", "Another person is seen in the camera", "कैमरे में कोई दूसरा व्यक्ति दिखना" ],
     [ "eye", "Looking away from the screen (left, right, up or down) continuously for more than 30 seconds", "लगातार 30 सेकंड से ज़्यादा स्क्रीन से नज़र हटाना (बाएँ, दाएँ, ऊपर या नीचे)" ],
     [ "phone", "A mobile phone, book, notebook or another laptop / screen is seen in the camera", "कैमरे में मोबाइल, किताब, नोटबुक या दूसरा लैपटॉप / स्क्रीन दिखना" ],
     [ "mic", "Talking, or loud voices / noise in the room", "बात करना, या कमरे में तेज़ आवाज़ / शोर" ],
     [ "activity", "Moving a lot, or moving out of the camera frame", "बहुत ज़्यादा हिलना, या कैमरे के फ्रेम से बाहर जाना" ],
     [ "camera", "Turning off or blocking the camera", "कैमरा बंद करना या उसे ब्लॉक करना" ],
     [ "monitor", "Laptop / computer: stopping screen sharing, or sharing a window instead of the entire screen", "लैपटॉप / कंप्यूटर: स्क्रीन शेयर बंद करना, या पूरी स्क्रीन की जगह सिर्फ़ एक विंडो शेयर करना" ],
     [ "copy", "Copy, paste or right-click", "कॉपी, पेस्ट या राइट-क्लिक करना" ],
     [ "lock", "Shortcut keys such as Ctrl+P, Ctrl+S, Ctrl+U, F12 or Print Screen", "Ctrl+P, Ctrl+S, Ctrl+U, F12 या Print Screen जैसी शॉर्टकट कुंजियाँ दबाना" ],
     [ "monitor", "A second monitor connected, or resizing / splitting the window", "दूसरा मॉनिटर जोड़ना, या विंडो को छोटा-बड़ा / स्प्लिट करना" ]
   ] %>

<div class="exam-wrap cg">
  <%= render "exams/header" %>

  <section class="candidate-hero cg-hero">
    <div class="top">
      <span class="eyebrow">ONLINE TEST · CANDIDATE GUIDE</span>
      <h1>Before you start your online test</h1>
      <p>ऑनलाइन टेस्ट शुरू करने से पहले इसे ध्यान से पढ़ें</p>
      <div class="cg-actions no-print">
        <a class="btn btn-light btn-sm" href="<%= request.script_name %>/candidate-guide.pdf" download><%= icon("download") %> Download PDF</a>
        <button class="btn btn-light btn-sm" onclick="window.print()"><%= icon("file") %> Print</button>
      </div>
    </div>
  </section>

  <section class="card cg-card">
    <h2><span class="cg-num">1</span> What you need <small>आपको क्या चाहिए</small></h2>
    <ul class="cg-list">
      <li><b>A laptop or desktop with a webcam and microphone</b> (recommended), with the latest <b>Google Chrome</b> or <b>Microsoft Edge</b>. A phone also works, but on a phone screen sharing is not possible.
        <span>वेबकैम और माइक वाला <b>लैपटॉप या कंप्यूटर</b> (सबसे अच्छा), नए <b>Google Chrome</b> या <b>Microsoft Edge</b> के साथ। फ़ोन से भी टेस्ट हो सकता है, पर फ़ोन पर स्क्रीन शेयर नहीं होता।</span></li>
      <li><b>Taking the test on a phone?</b> Keep it on a stand or against something, front camera facing you, face fully visible. Turn on <b>Do Not Disturb</b> so calls and notifications don't take you out of the test.
        <span><b>फ़ोन से टेस्ट दे रहे हैं?</b> फ़ोन को स्टैंड या किसी सहारे पर रखें, फ्रंट कैमरा आपकी ओर हो और पूरा चेहरा दिखे। <b>Do Not Disturb</b> चालू करें ताकि कॉल या नोटिफ़िकेशन से टेस्ट न छूटे।</span></li>
      <li><b>Stable internet</b> and a charged laptop / phone (keep the charger connected).
        <span><b>अच्छा इंटरनेट</b> और चार्ज लैपटॉप / फ़ोन (चार्जर लगा कर रखें)।</span></li>
      <li><b>A quiet room where you are alone</b>, with light on your face (the light should be in front of you, not behind you).
        <span><b>शांत कमरा जहाँ आप अकेले हों</b>, चेहरे पर रोशनी हो (रोशनी सामने से आए, पीछे से नहीं)।</span></li>
      <li>Open the test link in <b>Chrome</b>. If it opens inside WhatsApp, tap <b>⋮ → Open in Chrome</b>.
        <span>टेस्ट लिंक <b>Chrome</b> में खोलें। अगर लिंक WhatsApp के अंदर खुले, तो <b>⋮ → Open in Chrome</b> दबाएँ।</span></li>
      <li>Keep your <b>mobile number</b> ready — <b>HR will tell you the OTP</b>.
        <span>अपना <b>मोबाइल नंबर</b> तैयार रखें — <b>OTP आपको HR बताएँगे</b>।</span></li>
    </ul>
  </section>

  <section class="card cg-card">
    <h2><span class="cg-num">2</span> Pen, paper &amp; stationery <small>पेन, पेपर और स्टेशनरी</small></h2>
    <div class="cg-two">
      <div class="cg-ok">
        <h3><%= icon("check-circle") %> Allowed <small>अनुमति है</small></h3>
        <ul>
          <li>1–2 <b>blank sheets</b> for rough work <span>रफ़ काम के लिए 1–2 <b>खाली कागज़</b></span></li>
          <li><b>Pen or pencil</b>, eraser <span><b>पेन या पेंसिल</b>, रबर</span></li>
          <li>A glass of water <span>पानी का गिलास</span></li>
        </ul>
      </div>
      <div class="cg-no">
        <h3><%= icon("x-circle") %> Not allowed <small>अनुमति नहीं है</small></h3>
        <ul>
          <li><b>Mobile phone</b> (switch it off and keep it out of reach) <span><b>मोबाइल फ़ोन</b> (बंद करके दूर रखें)</span></li>
          <li><b>Calculator</b>, smartwatch, earphones <span><b>कैलकुलेटर</b>, स्मार्टवॉच, ईयरफ़ोन</span></li>
          <li>Books, notebooks, notes, printed papers <span>किताबें, नोटबुक, नोट्स, छपे हुए कागज़</span></li>
          <li>Another laptop, tablet or second screen <span>दूसरा लैपटॉप, टैबलेट या दूसरी स्क्रीन</span></li>
        </ul>
      </div>
    </div>
    <ul class="cg-list cg-tips">
      <li><b>No paper? Use the on-screen Rough sheet</b> — click <b>✏️ Rough sheet</b> at the top of the test to write with the mouse / finger, or type your calculations. It is saved automatically.
        <span><b>कागज़ नहीं है? स्क्रीन पर Rough sheet इस्तेमाल करें</b> — टेस्ट में ऊपर <b>✏️ Rough sheet</b> दबाकर माउस / उंगली से लिखें, या हिसाब टाइप करें। यह अपने-आप सेव होता है।</span></li>
      <li>Before starting, <b>show both sides of your blank sheets to the camera</b> for a few seconds.
        <span>टेस्ट शुरू करने से पहले अपने <b>खाली कागज़ दोनों तरफ़ से कैमरे को दिखाएँ</b>।</span></li>
      <li>Use <b>loose sheets, not a notebook</b> — a notebook or book in view can be flagged as “Book / notes”.
        <span><b>नोटबुक नहीं, खुले कागज़</b> इस्तेमाल करें — कैमरे में नोटबुक या किताब दिखने पर “Book / notes” की चेतावनी आ सकती है।</span></li>
      <li>While writing rough work, <b>look up at the screen regularly</b>. Looking down for more than 30 seconds at a stretch gives a warning.
        <span>रफ़ काम लिखते समय <b>बीच-बीच में स्क्रीन की ओर देखते रहें</b>। लगातार 30 सेकंड से ज़्यादा नीचे देखने पर चेतावनी आती है।</span></li>
    </ul>
  </section>

  <section class="card cg-card">
    <h2><span class="cg-num">3</span> What gives a warning <small>किन बातों पर चेतावनी (Warning) आती है</small></h2>
    <p class="cg-note">Your camera, microphone and (on a laptop) your whole screen are recorded during the test. Each of these gives a <b>warning with a beep</b>, and <b>HR is alerted live</b> with a photo:
      <span>टेस्ट के दौरान आपका कैमरा, माइक और (लैपटॉप पर) पूरी स्क्रीन रिकॉर्ड होती है। नीचे दी गई हर बात पर <b>बीप के साथ चेतावनी</b> आती है और <b>HR को तुरंत फ़ोटो के साथ सूचना</b> जाती है:</span></p>
    <ol class="cg-warn">
      <% warnings.each do |ico, en, hi| %>
        <li><span class="cg-ico"><%= icon(ico) %></span><div><b><%= en %></b><span><%= hi %></span></div></li>
      <% end %>
    </ol>
    <div class="cg-alert"><%= icon("alert") %>
      <div><b>Too many warnings end the test automatically</b> (the limit is set by HR — usually 5). Your answers up to that point are submitted.
        <span><b>तय सीमा से ज़्यादा चेतावनियाँ होने पर टेस्ट अपने-आप खत्म हो जाता है</b> (सीमा HR तय करते हैं — आमतौर पर 5)। तब तक के उत्तर जमा हो जाते हैं।</span></div>
    </div>
  </section>

  <section class="card cg-card">
    <h2><span class="cg-num">4</span> During the test <small>टेस्ट के दौरान</small></h2>
    <ul class="cg-list">
      <li>Allow the <b>camera and microphone</b> when the browser asks. On a laptop, click <b>Share entire screen</b> and choose <b>“Entire screen”</b>.
        <span>ब्राउज़र पूछे तो <b>कैमरा और माइक</b> की अनुमति दें। लैपटॉप पर <b>Share entire screen</b> दबाकर <b>“Entire screen”</b> चुनें।</span></li>
      <li>The test runs in <b>full screen</b> with a <b>timer</b>. It is <b>submitted automatically</b> when the time ends.
        <span>टेस्ट <b>फुल स्क्रीन</b> में और <b>टाइमर</b> के साथ चलता है। समय खत्म होते ही <b>अपने-आप जमा</b> हो जाता है।</span></li>
      <li>You can answer in any order: <b>Skip</b> a question and come back to it with <b>Previous</b> or the question numbers. Skipped questions show in red.
        <span>प्रश्न किसी भी क्रम में कर सकते हैं: <b>Skip</b> करें और बाद में <b>Previous</b> या प्रश्न-संख्या से वापस आएँ। छोड़े गए प्रश्न लाल दिखते हैं।</span></li>
      <li>Answers are <b>saved automatically</b>. If the page closes by mistake, open the <b>same link</b> again — the timer keeps running.
        <span>उत्तर <b>अपने-आप सेव</b> होते हैं। गलती से पेज बंद हो जाए तो <b>वही लिंक</b> दोबारा खोलें — टाइमर चलता रहता है।</span></li>
      <li>There is <b>no negative marking</b> — a wrong or skipped answer gets 0.
        <span><b>कोई नेगेटिव मार्किंग नहीं</b> है — गलत या छोड़े गए उत्तर के 0 अंक।</span></li>
      <li>HR may start a <b>video call or chat</b> during the test — answering them is allowed.
        <span>टेस्ट के दौरान HR <b>वीडियो कॉल या चैट</b> शुरू कर सकते हैं — उनसे बात करना मना नहीं है।</span></li>
    </ul>
  </section>

  <section class="card cg-card">
    <h2><span class="cg-num">5</span> If something doesn't work <small>कोई दिक्कत हो तो</small></h2>
    <ul class="cg-list">
      <li><b>Camera blocked:</b> click the 🔒 / camera icon in the address bar → allow Camera and Microphone → reload the page.
        <span><b>कैमरा ब्लॉक:</b> एड्रेस बार में 🔒 / कैमरा आइकन दबाएँ → Camera और Microphone को Allow करें → पेज रीलोड करें।</span></li>
      <li><b>Camera busy:</b> close Zoom, Meet, Teams or any other app using the camera.
        <span><b>कैमरा व्यस्त:</b> Zoom, Meet, Teams या कैमरा इस्तेमाल करने वाला कोई और ऐप बंद करें।</span></li>
      <li>For any other problem, <b>contact HR before starting</b> the test.
        <span>कोई और दिक्कत हो तो टेस्ट शुरू करने से <b>पहले HR से संपर्क</b> करें।</span></li>
    </ul>
  </section>

  <p class="cg-foot">All the best! · शुभकामनाएँ!</p>
</div>
