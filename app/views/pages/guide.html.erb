<% content_for :title, @lang == "hi" ? "गाइड" : "Guide" %>
<%= render layout: "shared/page_header", locals: {
      title: @lang == "hi" ? "ASA CHAYAN कैसे काम करता है" : "How ASA CHAYAN works", icon: "sparkles",
      crumbs: [ [ "Dashboard", root_path ] ] } do %>
  <nav class="guide-lang" aria-label="Language">
    <%= link_to "English", guide_path, class: ("active" if @lang == "en") %>
    <%= link_to "हिंदी", guide_path(lang: "hi"), class: ("active" if @lang == "hi") %>
  </nav>
  <button type="button" class="btn btn-light" onclick="window.print()"><%= icon("download") %> <%= @lang == "hi" ? "PDF सेव करें" : "Save as PDF" %></button>
  <%= link_to new_invitation_path, class: "btn btn-primary" do %><%= icon("send") %> <%= @lang == "hi" ? "कैंडिडेट को बुलाएँ" : "Invite a candidate" %><% end %>
<% end %>

<%# The guide candidates get with their test link (attach it to the mail / WhatsApp) %>
<section class="card send-guide" data-controller="clipboard">
  <div class="send-guide-ico"><%= icon("file") %></div>
  <div class="grow">
    <h2><%= @lang == "hi" ? "कैंडिडेट गाइड — कैंडिडेट को भेजें" : "Candidate guide — send to candidates" %></h2>
    <p><%= @lang == "hi" ? "टेस्ट में क्या चाहिए, पेन-पेपर के नियम, किन बातों पर चेतावनी आती है और टेस्ट कैसे दें। PDF डाउनलोड करके मेल / WhatsApp के साथ भेजें — लिंक टेस्ट के मैसेज में अपने-आप जुड़ता है।" : "What candidates need, pen & paper rules, every action that gives a warning and how the test works. Download the PDF and attach it to the mail / WhatsApp — the link is also added to the test message automatically." %></p>
    <input type="hidden" value="<%= candidate_guide_url %>" data-clipboard-target="source">
  </div>
  <div class="send-guide-actions">
    <span class="tiny muted"><%= @lang == "hi" ? "PDF डाउनलोड:" : "Download PDF:" %></span>
    <a class="btn btn-light btn-sm" href="<%= request.script_name %>/candidate-guide-en.pdf" download><%= icon("download") %> English</a>
    <a class="btn btn-light btn-sm" href="<%= request.script_name %>/candidate-guide-hi.pdf" download><%= icon("download") %> हिंदी</a>
    <a class="btn btn-primary btn-sm" href="<%= request.script_name %>/candidate-guide.pdf" download><%= icon("download") %> English + हिंदी</a>
    <%= link_to candidate_guide_path, class: "btn btn-light btn-sm", target: "_blank", rel: "noopener" do %><%= icon("eye") %> <%= @lang == "hi" ? "देखें" : "Open" %><% end %>
    <button type="button" class="btn btn-light btn-sm" data-action="clipboard#copy"><%= icon("copy") %> <span data-clipboard-target="label"><%= @lang == "hi" ? "लिंक कॉपी करें" : "Copy link" %></span></button>
  </div>
</section>

<%= render "pages/guide_#{@lang}" %>
