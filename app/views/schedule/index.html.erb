<% content_for :title, "Schedule" %>
<%= render layout: "shared/page_header", locals: {
      title: "Interview schedule", subtitle: "Every upcoming interview round across candidates. Set dates and panels from each candidate's page.", icon: "calendar",
      crumbs: [ [ "Dashboard", root_path ] ],
      stats: [
        { label: "Live now", value: @live.size, icon: "video", tone: "red" },
        { label: "Today", value: @days[Date.current]&.size.to_i, icon: "calendar", tone: "violet" },
        { label: "Upcoming", value: @days.values.sum(&:size), icon: "clock", tone: "blue" },
        { label: "Not scheduled", value: @unscheduled.size, icon: "alert", tone: "amber" }
      ] } do %>
<% end %>

<% if @live.any? %>
  <div class="card sched-day"><div class="card-head"><h2><span class="live-dot" style="background:var(--red)"></span> Live now</h2></div><%= render partial: "schedule/row", collection: @live, as: :r %></div>
<% end %>
<% @days.each do |day, rounds| %>
  <div class="card sched-day">
    <div class="card-head"><h2><%= icon("calendar") %> <%= day == Date.current ? "Today" : (day == Date.tomorrow ? "Tomorrow" : day.strftime("%A, %d %B")) %></h2><span class="tiny muted"><%= pluralize(rounds.size, "round") %></span></div>
    <%= render partial: "schedule/row", collection: rounds, as: :r %>
  </div>
<% end %>
<% if @unscheduled.any? %>
  <div class="card sched-day"><div class="card-head"><h2><%= icon("alert") %> Not scheduled yet</h2><span class="tiny muted">Open the candidate to set a date</span></div><%= render partial: "schedule/row", collection: @unscheduled, as: :r %></div>
<% end %>
<% if @live.empty? && @days.empty? && @unscheduled.empty? %>
  <div class="card empty"><div class="ico"><%= icon("calendar") %></div><h3>No interviews coming up</h3><p>Rounds appear here once candidates finish their test.</p></div>
<% end %>
