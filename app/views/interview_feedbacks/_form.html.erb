<%# Scorecard for one round. locals: round:, feedback:, url:, panelists: (panelist view picks a name), saved: %>
<%= form_with model: feedback, url: url, method: :post, id: "feedback_form_#{round.id}", class: "card scorecard" do |f| %>
  <div class="card-head"><h2><%= icon("award") %> Your scorecard</h2><span class="tiny muted"><%= round.name %></span></div>
  <div class="card-body stack">
    <% if local_assigns[:saved] %>
      <div class="saved-note"><%= icon("check-circle") %> Saved<%= " — thanks #{feedback.reviewer_name.split.first}" if feedback.reviewer_name.present? %>. You can update it any time.</div>
    <% end %>
    <% if feedback.errors.any? %><div class="errors" style="margin:0"><%= feedback.errors.full_messages.to_sentence %></div><% end %>
    <% if local_assigns[:panelists] %>
      <% if panelists.any? %>
        <div class="field">
          <label for="employee_id_<%= round.id %>">I am <span class="req">*</span></label>
          <%= select_tag :employee_id, options_for_select(panelists.map { |p| [ p.name, p.id ] }, feedback.employee_id), prompt: "Choose your name", class: "input", id: "employee_id_#{round.id}" %>
        </div>
        <div class="field">
          <label for="reviewer_name_<%= round.id %>" class="tiny muted">Not in the list? Type your name instead</label>
          <%= text_field_tag :reviewer_name, (feedback.reviewer_name if feedback.employee_id.nil?), class: "input", id: "reviewer_name_#{round.id}", maxlength: 60, placeholder: "Your full name" %>
        </div>
      <% else %>
        <div class="field">
          <label for="reviewer_name_<%= round.id %>">Your name <span class="req">*</span></label>
          <%= text_field_tag :reviewer_name, feedback.reviewer_name, class: "input", id: "reviewer_name_#{round.id}", maxlength: 60, required: true, placeholder: "Your full name" %>
        </div>
      <% end %>
    <% end %>
    <p class="tiny muted" style="margin:-.3rem 0 0">Score only what you assessed — leave the rest on "Skip".</p>
    <% round.score_parameters.each do |param| %>
      <% value = feedback.scores[param] %>
      <div class="score-row">
        <label><%= param %></label>
        <div class="score-pills">
          <label class="pill-skip"><input type="radio" name="interview_feedback[scores][<%= param %>]" value="" <%= "checked" if value.nil? %>><span>Skip</span></label>
          <% (1..10).each do |n| %>
            <label class="<%= n <= 4 ? 'lo' : (n <= 7 ? 'mid' : 'hi') %>"><input type="radio" name="interview_feedback[scores][<%= param %>]" value="<%= n %>" <%= "checked" if value == n %>><span><%= n %></span></label>
          <% end %>
        </div>
      </div>
    <% end %>
    <div class="field">
      <label>Recommendation <span class="req">*</span></label>
      <div class="reco-grid">
        <% InterviewFeedback::RECOMMENDATIONS.each do |key, label| %>
          <label class="reco reco-<%= key %>"><%= f.radio_button :recommendation, key, required: true %><span><%= label %></span></label>
        <% end %>
      </div>
    </div>
    <div class="field">
      <%= f.label :comments, "Comments" %>
      <%= f.text_area :comments, rows: 3, class: "input", placeholder: "Strengths, concerns, follow-ups…" %>
    </div>
    <%= f.button class: "btn btn-primary btn-block" do %><%= icon("check") %> <%= feedback.persisted? ? "Update feedback" : "Submit feedback" %><% end %>
  </div>
<% end %>
